---
const title = "ASTA — Mail order coupon";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0"
    />
    <title>{title}</title>
  </head>

  <body>

    <!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

    <header class="header">

      <div class="header-inner">

        <div class="double-lines"></div>

        <div class="header-content">

          <div class="logo-wrapper">

            <div class="logo-icon">
<img
  id="siteLogo"
  alt="ASTA Logo"
  class="logo-img"
/>
            </div>

            <div class="logo">
              ASTA
            </div>

          </div>


          <div class="right-side">

            <a
              id="headerFacebookLink"
              href="https://www.facebook.com/astabagsbd"
              target="_blank"
              rel="noopener noreferrer"
            >
              FACEBOOK
            </a>

            <button
              id="cartHeaderBtn"
              type="button"
              class="cart-header-btn"
              onclick="window.location.href='/'"
            >

              <svg
                class="cart-icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <path d="M16 10a4 4 0 0 1-8 0" />
              </svg>

              <span>
                CART <span id="cartCount">0</span>
              </span>

            </button>

          </div>

        </div>

      </div>

    </header>


    <!-- ========================= -->
    <!-- INFO BAR -->
    <!-- ========================= -->

    <div class="info-bar">

      <span>EDITION NO. 04</span>

      <span>HANDMADE LEATHER · DHAKA</span>

      <span>CASH ON DELIVERY</span>

      <span>EXCHANGE WITHIN THREE DAYS</span>

    </div>


    <!-- ========================= -->
    <!-- BACK LINK -->
    <!-- ========================= -->

    <div class="back-link-wrap">

      <a
        href="/"
        class="back-link"
      >
        ← BACK TO THE EDITION
      </a>

    </div>


    <!-- ========================= -->
    <!-- MAIN -->
    <!-- ========================= -->

    <main class="coupon-page">

      <div class="coupon-header">

        <h1>
          Mail order coupon
        </h1>

        <span class="coupon-note">
          FILL IN INK · WE CALL TO CONFIRM
        </span>

      </div>


      <div class="coupon-grid">


        <!-- ========================= -->
        <!-- ORDER FORM -->
        <!-- ========================= -->

        <form
          id="orderForm"
          class="coupon-form"
          novalidate
        >


          <!-- NAME + PHONE -->

          <div class="form-row">

            <div class="form-group">

              <label for="fullName">
                FULL NAME <span class="req">*</span>
              </label>

              <input
                type="text"
                id="fullName"
                name="fullName"
                required
                placeholder="Your name"
              />

            </div>


            <div class="form-group">

              <label for="phone">
                PHONE (WHATSAPP) <span class="req">*</span>
              </label>

              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="01XXXXXXXXX"
              />

            </div>

          </div>


          <!-- EMAIL + DISTRICT -->

          <div class="form-row">

            <div class="form-group">

              <label for="email">
                EMAIL
              </label>

              <input
                type="email"
                id="email"
                name="email"
                placeholder="optional"
              />

            </div>


            <div class="form-group">

              <label for="district">
                DISTRICT / AREA
                <span class="req">*</span>
              </label>

              <select
                id="district"
                name="district"
                required
              >

                <option value="">
                  Select
                </option>

                <option value="Dhaka">
                  Dhaka
                </option>

                <option value="Chattogram">
                  Chattogram
                </option>

                <option value="Sylhet">
                  Sylhet
                </option>

                <option value="Rajshahi">
                  Rajshahi
                </option>

                <option value="Khulna">
                  Khulna
                </option>

                <option value="Barishal">
                  Barishal
                </option>

                <option value="Rangpur">
                  Rangpur
                </option>

                <option value="Mymensingh">
                  Mymensingh
                </option>

                <option value="Other">
                  Other
                </option>

              </select>

            </div>

          </div>


          <!-- ADDRESS -->

          <div class="form-group full">

            <label for="address">
              FULL ADDRESS
              <span class="req">*</span>
            </label>

            <textarea
              id="address"
              name="address"
              rows="3"
              required
              placeholder="House, road, area, landmark"
            ></textarea>

          </div>


          <!-- PAYMENT -->

          <div class="form-group full">

            <label>
              PAYMENT
              <span class="req">*</span>
            </label>


            <div class="payment-options">


              <!-- COD -->

              <label class="payment-option">

                <input
                  type="radio"
                  name="payment"
                  value="cod"
                  checked
                />

                <span class="radio-custom"></span>

                <div>

                  <strong>
                    Cash on delivery
                  </strong>

                  <small>
                    Pay the rider when the bag arrives.
                  </small>

                </div>

              </label>


              <!-- BKASH -->

              <label class="payment-option">

                <input
                  type="radio"
                  name="payment"
                  value="bkash"
                />

                <span class="radio-custom"></span>

                <div>

                  <strong>
                    bKash — send money
                  </strong>

                  <small>
                    Send to 01577 488708, then write the TrxID below.
                  </small>

                </div>

              </label>


              <!-- NAGAD -->

              <label class="payment-option">

                <input
                  type="radio"
                  name="payment"
                  value="nagad"
                />

                <span class="radio-custom"></span>

                <div>

                  <strong>
                    Nagad — send money
                  </strong>

                  <small>
                    Send to 01577 488708, then write the TrxID below.
                  </small>

                </div>

              </label>


              <!-- BANK -->

              <label class="payment-option">

                <input
                  type="radio"
                  name="payment"
                  value="bank"
                />

                <span class="radio-custom"></span>

                <div>

                  <strong>
                    Bank transfer
                  </strong>

                  <small>
                    We share account details on WhatsApp; add the slip number.
                  </small>

                </div>

              </label>

            </div>

          </div>


          <!-- PAYMENT REFERENCE -->

          <div
            class="form-group full payment-reference"
            id="paymentReference"
            style="display:none;"
          >

            <label for="paymentReferenceInput">

              PAYMENT REFERENCE / TRXID

              <span class="req">
                *
              </span>

            </label>

            <input
              type="text"
              id="paymentReferenceInput"
              name="paymentReference"
              placeholder="e.g. 9F2K4L8Q1"
            />

            <small
              class="payment-reference-note"
              id="paymentReferenceNote"
            >
              Send Money to 01577 488708 (personal), then paste the TrxID.
            </small>

          </div>


          <!-- ORDER NOTES -->

          <div class="form-group full">

            <label for="notes">
              ORDER NOTES
            </label>

            <textarea
              id="notes"
              name="notes"
              rows="2"
              placeholder="Delivery timing, gift wrap, anything else"
            ></textarea>

          </div>


          <!-- ERROR -->

          <p
            id="formError"
            class="form-error"
            style="display:none;"
          >
            Please fill in your name, phone and full address.
          </p>


          <!-- PLACE ORDER -->

          <button
            type="submit"
            class="place-order-btn"
            id="placeOrderBtn"
          >
            PLACE ORDER · ৳0
          </button>


          <p class="form-footer-note">
            Nothing is charged online. We ring you within a few hours.
          </p>

        </form>


        <!-- ========================= -->
        <!-- ORDER SUMMARY -->
        <!-- ========================= -->

        <aside class="order-summary">

          <h3 class="your-order-title">
            YOUR ORDER
          </h3>

          <div id="summaryItems"></div>


          <div class="summary-totals">

            <div class="summary-row">

              <span>
                Subtotal
              </span>

              <span id="summarySubtotal">
                ৳0
              </span>

            </div>


            <div class="summary-row">

              <span>
                Delivery ·
                <span id="deliveryLabel">
                  inside Dhaka
                </span>
              </span>

              <span id="summaryDelivery">
                ৳80
              </span>

            </div>


            <div class="summary-row total-row">

              <span>
                Total
              </span>

              <span id="summaryTotal">
                ৳0
              </span>

            </div>

          </div>

        </aside>

      </div>

    </main>


    <!-- ========================= -->
    <!-- FOOTER -->
    <!-- ========================= -->

    <footer class="footer">

      <div class="footer-inner">

        <div class="footer-left">
          ASTA BAGS · DHAKA, BANGLADESH
        </div>


        <div class="footer-right">

          <a
            href="https://www.facebook.com/astabagsbd"
            target="_blank"
            rel="noopener noreferrer"
          >
            FACEBOOK
          </a>

<a
  id="footerWhatsappLink"
  href="#"
  target="_blank"
  rel="noopener noreferrer"
>
  +880 1577 488708
</a>

        </div>

      </div>

    </footer>


    <!-- ========================= -->
    <!-- FLOATING BUTTONS -->
    <!-- ========================= -->

    <div class="floating-buttons">


      <a
        href="https://www.facebook.com/astabagsbd"
        target="_blank"
        rel="noopener noreferrer"
        class="float-btn fb-btn"
        aria-label="Facebook"
      >

        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
        </svg>

      </a>


<a
  id="floatingWhatsapp"
  href="#"
  target="_blank"
  rel="noopener noreferrer"
  class="float-btn wa-btn"
>

        <svg
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>

        <span>
          WHATSAPP
        </span>

      </a>

    </div>


    <!-- ========================= -->
    <!-- JAVASCRIPT -->
    <!-- ========================= -->

    <script type="module">

      import { createClient }
        from 'https://esm.sh/@supabase/supabase-js@2';


 const supabase = createClient(
  'https://ryfufhtymvjeveppwjoj.supabase.co',
  'sb_publishable_nzsU-ZYMEiOz1hxfsC6Spw_GXfaaVfw',
  { auth: { storageKey: 'asta-admin-auth' } }
);


      /* CART */

      const cart =
        JSON.parse(
          localStorage.getItem('asta_cart')
        ) || [];


      if (cart.length === 0) {
        window.location.href = '/';
      }


      const totalItems =
        cart.reduce(
          (sum, item) =>
            sum + item.quantity,
          0
        );


      document
        .getElementById('cartCount')
        .textContent = totalItems;


      let subtotal = 0;


      cart.forEach(item => {

        subtotal +=
          item.price * item.quantity;

      });


      /* DELIVERY */

      let delivery = 80;

      const districtSelect =
        document.getElementById(
          'district'
        );


      function updateTotals() {

        const isDhaka =
          districtSelect.value === 'Dhaka' ||
          districtSelect.value === '';


        delivery =
          isDhaka
            ? 80
            : 130;


        document
          .getElementById('deliveryLabel')
          .textContent =
            isDhaka
              ? 'inside Dhaka'
              : 'outside Dhaka';


        document
          .getElementById('summaryDelivery')
          .textContent =
            `৳${delivery}`;


        document
          .getElementById('summarySubtotal')
          .textContent =
            `৳${subtotal.toLocaleString()}`;


        document
          .getElementById('summaryTotal')
          .textContent =
            `৳${(
              subtotal + delivery
            ).toLocaleString()}`;


        document
          .getElementById('placeOrderBtn')
          .textContent =
            `PLACE ORDER · ৳${(
              subtotal + delivery
            ).toLocaleString()}`;

      }


      /* ORDER SUMMARY */

      const summaryContainer =
        document.getElementById(
          'summaryItems'
        );


      summaryContainer.innerHTML =
        cart.map(item => {

          const lineTotal =
            item.price * item.quantity;


          return `

            <div class="summary-item">

              <img
                src="${item.image}"
                alt="${item.name}"
                class="summary-img"
              />

              <div class="summary-info">

                <div class="summary-name">
                  ${item.name}
                </div>

                <div class="summary-meta">
                  ${item.variant} · ${item.quantity}
                </div>

              </div>

              <div class="summary-price">
                ৳${lineTotal.toLocaleString()}
              </div>

            </div>

          `;

        }).join('');


      updateTotals();


      districtSelect.addEventListener(
        'change',
        updateTotals
      );


      /* PAYMENT */

      const paymentRadios =
        document.querySelectorAll(
          'input[name="payment"]'
        );


      const paymentReference =
        document.getElementById(
          'paymentReference'
        );


      const paymentReferenceInput =
        document.getElementById(
          'paymentReferenceInput'
        );


      const paymentReferenceNote =
        document.getElementById(
          'paymentReferenceNote'
        );


      function updatePaymentReference() {

        const selectedPayment =
          document.querySelector(
            'input[name="payment"]:checked'
          )?.value;


        if (
          selectedPayment === 'cod'
        ) {

          paymentReference.style.display =
            'none';

          paymentReferenceInput.value =
            '';

          paymentReferenceInput.required =
            false;

          return;

        }


        paymentReference.style.display =
          'flex';

        paymentReferenceInput.required =
          true;


        if (
          selectedPayment === 'bkash' ||
          selectedPayment === 'nagad'
        ) {

          paymentReferenceInput.placeholder =
            'e.g. 9F2K4L8Q1';

          paymentReferenceNote.textContent =
            'Send Money to 01577 488708 (personal), then paste the TrxID.';

        }


        if (
          selectedPayment === 'bank'
        ) {

          paymentReferenceInput.placeholder =
            'e.g. Bank reference number';

          paymentReferenceNote.textContent =
            'Add the bank transfer slip / reference number.';

        }

      }


      paymentRadios.forEach(
        radio => {

          radio.addEventListener(
            'change',
            updatePaymentReference
          );

        }
      );


      updatePaymentReference();


      /* FORM SUBMIT */

      document
        .getElementById('orderForm')
        .addEventListener(
          'submit',
          async e => {

            e.preventDefault();


            const form =
              e.target;


            const fullName =
              form.fullName.value.trim();


            const phone =
              form.phone.value.trim();


            const district =
              form.district.value;


            const address =
              form.address.value.trim();


            const payment =
              form.payment.value;


            const paymentReferenceValue =
              form.paymentReference.value.trim();


            const email =
              form.email.value.trim();


            const notes =
              form.notes.value.trim();


            const errorEl =
              document.getElementById(
                'formError'
              );


            const button =
              document.getElementById(
                'placeOrderBtn'
              );


            if (
              !fullName ||
              !phone ||
              !address ||
              !district
            ) {

              errorEl.textContent =
                'Please fill in your name, phone and full address.';

              errorEl.style.display =
                'block';

              return;

            }


            if (
              payment !== 'cod' &&
              !paymentReferenceValue
            ) {

              errorEl.textContent =
                'Please enter your payment reference / TrxID.';

              errorEl.style.display =
                'block';

              paymentReferenceInput.focus();

              return;

            }


            errorEl.style.display =
              'none';


            const orderId =
              'AB-' +
              Math.floor(
                1000 +
                Math.random() * 9000
              );


            const deliveryCost =
              district === 'Dhaka'
                ? 80
                : 130;


            const total =
              subtotal + deliveryCost;


            button.disabled =
              true;


            button.textContent =
              'PLACING ORDER...';


            const { data, error } =
              await supabase
                .from('orders')
                .insert([{

                  order_id: orderId,

                  full_name: fullName,

                  phone: phone,

                  email:
                    email || null,

                  district: district,

                  address: address,

                  payment: payment,

                  payment_reference:
                    paymentReferenceValue ||
                    null,

                  notes:
                    notes || null,

                  items: cart,

                  subtotal: subtotal,

                  delivery:
                    deliveryCost,

                  total: total

                }]);


            if (error) {

              console.error(
                'Supabase order error:',
                error
              );


              button.disabled =
                false;


              button.textContent =
                `PLACE ORDER · ৳${total.toLocaleString()}`;


              errorEl.textContent =
                'Something went wrong. Please try again.';


              errorEl.style.display =
                'block';

              return;

            }


            localStorage.setItem(
              'asta_last_order',
              JSON.stringify({

                orderId,

                fullName,

                phone,

                email,

                district,

                address,

                payment,

                paymentReference:
                  paymentReferenceValue,

                notes,

                items: cart,

                subtotal,

                delivery:
                  deliveryCost,

                total

              })
            );


            localStorage.removeItem(
              'asta_cart'
            );


            window.location.href =
              '/thank-you';

          }
        );





          







    </script>


    <!-- ========================= -->
    <!-- GLOBAL CSS -->
    <!-- ========================= -->

    <style is:global>

      * {
        box-sizing: border-box;
      }


      html {
        width: 100%;
        overflow-x: hidden;
      }


      body {
        margin: 0;
        width: 100%;
        overflow-x: hidden;
        background: #f4f3ef;
        color: #151515;
        font-family: Georgia, serif;
      }


      img {
        max-width: 100%;
      }


      button,
      input,
      textarea,
      select {
        font: inherit;
      }


      /* ========================= */
      /* HEADER */
      /* ========================= */

      .header {
        width: 100%;
        padding: 40px 40px 0;
      }


      .header-inner {
        width: 100%;
      }


      .double-lines {
        height: 2px;
        border-top: 1px solid #151515;
        border-bottom: 1px solid #151515;
        margin-bottom: 24px;
      }


      .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
        padding-bottom: 24px;
        border-bottom: 1px solid #bdbbb5;
      }


      .logo-wrapper {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
      }


      .logo-icon {
        width: 70px;
        height: 70px;
        background: #e6ff2b;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }


      .logo-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }


      .logo {
        font-size: 58px;
        font-weight: 700;
        letter-spacing: 4px;
        line-height: 1;
      }


      .right-side {
        display: flex;
        align-items: center;
        gap: 30px;
        flex-shrink: 0;
      }


      .right-side a {
        text-decoration: none;
        color: #008ca3;
        font-family: Arial, sans-serif;
        font-size: 12px;
        letter-spacing: 1.5px;
      }


      .cart-header-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        border: 1px solid #999;
        padding: 11px 18px;
        font-family: Arial, sans-serif;
        font-size: 12px;
        letter-spacing: 1.2px;
        color: #151515;
        cursor: pointer;
        white-space: nowrap;
      }


      .cart-icon {
        width: 15px;
        height: 15px;
      }


      /* ========================= */
      /* INFO BAR */
      /* ========================= */

      .info-bar {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 12px 40px;
        border-bottom: 1px solid #bdbbb5;
        font-family: Arial, sans-serif;
        font-size: 10px;
        letter-spacing: 1.5px;
        color: #666;
      }


      /* ========================= */
      /* BACK */
      /* ========================= */

      .back-link-wrap {
        padding: 28px 40px 0;
      }


      .back-link {
        font-family: Arial, sans-serif;
        font-size: 11px;
        letter-spacing: 1.5px;
        color: #008ca3;
        text-decoration: none;
      }


      /* ========================= */
      /* MAIN */
      /* ========================= */

      .coupon-page {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 40px 80px;
      }


      .coupon-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 30px;
        margin-bottom: 40px;
        padding-bottom: 16px;
        border-bottom: 1px solid #bdbbb5;
      }


      .coupon-header h1 {
        margin: 0;
        font-size: 42px;
        font-weight: 500;
        letter-spacing: -0.5px;
      }


      .coupon-note {
        font-family: Arial, sans-serif;
        font-size: 10px;
        letter-spacing: 1.5px;
        color: #666;
        white-space: nowrap;
      }


      /* ========================= */
      /* GRID */
      /* ========================= */

      .coupon-grid {
        display: grid;
