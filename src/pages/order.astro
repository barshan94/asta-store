              <span id="summarySubtotal">৳0</span>
            </div>
            <div class="summary-row">
              <span>Delivery · <span id="deliveryLabel">inside Dhaka</span></span>
              <span id="summaryDelivery">৳80</span>
            </div>
            <div class="summary-row total-row">
              <span>Total</span>
              <span id="summaryTotal">৳0</span>
            </div>
          </div>
        </aside>



      </div>
    </main>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-left">ASTA BAGS · DHAKA, BANGLADESH</div>
        <div class="footer-right">
