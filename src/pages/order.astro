      <div class="header-inner">
        <div class="double-lines"></div>
        <div class="header-content">
          <div class="logo-wrapper">
            <div class="logo-icon">
              <img src="/images/logo.jpg" alt="ASTA Logo" class="logo-img" />
            </div>
            <div class="logo">ASTA</div>
          </div>

          <div class="right-side">
            <a href="https://www.facebook.com/astabagsbd" target="_blank" rel="noopener noreferrer">FACEBOOK</a>
            <button id="cartHeaderBtn" type="button" class="cart-header-btn" onclick="window.location.href='/'">
              <svg class="cart-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
