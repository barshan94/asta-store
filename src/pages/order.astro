                <line x1="3" y1="6" x2="21" y2="6"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
              <span>CART <span id="cartCount">0</span></span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <div class="info-bar">
      <span>EDITION NO. 04</span>
      <span>HANDMADE LEATHER · DHAKA</span>
      <span>CASH ON DELIVERY</span>
      <span>EXCHANGE WITHIN THREE DAYS</span>
    </div>

    <!-- BACK LINK -->
    <div class="back-link-wrap">
      <a href="/" class="back-link">← BACK TO THE EDITION</a>

    </div>

    <!-- MAIN CONTENT -->
    <main class="coupon-page">
      <div class="coupon-header">
        <h1>Mail order coupon</h1>
        <!-- Change the coupon header note if needed -->
<!-- Coupon header note – exact text from source -->
<span class="coupon-note">FILL IN INK · WE CALL TO CONFIRM</span>
      </div>

      <div class="coupon-grid">
        <!-- LEFT: FORM -->
        <form id="orderForm" class="coupon-form" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="fullName">FULL NAME <span class="req">*</span></label>
              <input type="text" id="fullName" name="fullName" required placeholder="Your name" />
            </div>
            <div class="form-group">
              <label for="phone">PHONE (WHATSAPP) <span class="req">*</span></label>
              <input type="tel" id="phone" name="phone" required placeholder="01XXXXXXXXX" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="email">EMAIL</label>
              <input type="email" id="email" name="email" placeholder="optional" />
            </div>
            <div class="form-group">
              <label for="district">DISTRICT / AREA <span class="req">*</span></label>
              <select id="district" name="district" required>
                <option value="">Select</option>
                <option value="Dhaka">Dhaka</option>
                <option value="Chattogram">Chattogram</option>
                <option value="Sylhet">Sylhet</option>
                <option value="Rajshahi">Rajshahi</option>
                <option value="Khulna">Khulna</option>
                <option value="Barishal">Barishal</option>
                <option value="Rangpur">Rangpur</option>
                <option value="Mymensingh">Mymensingh</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <div class="form-group full">
            <label for="address">FULL ADDRESS <span class="req">*</span></label>
            <textarea id="address" name="address" rows="3" required placeholder="House, road, area, landmark"></textarea>
          </div>

          

                    <!-- PAYMENT -->
          <div class="form-group full">
            <label>PAYMENT <span class="req">*</span></label>
            <div class="payment-options">
              <label class="payment-option">
                <input type="radio" name="payment" value="cod" checked />
                <span class="radio-custom"></span>
                <div>
                  <strong>Cash on delivery</strong>
                  <small>Pay the rider when the bag arrives.</small>
                </div>
              </label>

              <label class="payment-option">
                <input type="radio" name="payment" value="bkash" />
                <span class="radio-custom"></span>
                <div>
                  <strong>bKash — send money</strong>
                  <small>Send to 01577 488708, then write the TrxID below.</small>
                </div>
              </label>

              <label class="payment-option">
                <input type="radio" name="payment" value="nagad" />
                <span class="radio-custom"></span>
                <div>
                  <strong>Nagad — send money</strong>
                  <small>Send to 01577 488708, then write the TrxID below.</small>
                </div>
              </label>

              <label class="payment-option">
                <input type="radio" name="payment" value="bank" />
                <span class="radio-custom"></span>
                <div>
                  <strong>Bank transfer</strong>
                  <small>We share account details on WhatsApp; add the slip number.</small>
                </div>
              </label>
            </div>
          </div>

          <!-- ORDER NOTES -->
          <div class="form-group full">
            <label for="notes">ORDER NOTES</label>
            <textarea id="notes" name="notes" rows="2" placeholder="Delivery timing, gift wrap, anything else"></textarea>
          </div>

        

          <!-- Error message (hidden by default) -->
<p id="formError" class="form-error" style="display: none;">
  Please fill in your name, phone and full address.
</p>

<button type="submit" class="place-order-btn" id="placeOrderBtn">
  PLACE ORDER · ৳0
</button>



          <p class="form-footer-note">
            Nothing is charged online. We ring you within a few hours.
          </p>



        </form>

        <!-- RIGHT: ORDER SUMMARY -->
       

        <!-- RIGHT: ORDER SUMMARY -->
        <aside class="order-summary">
          <h3 class="your-order-title">YOUR ORDER</h3>

          <div id="summaryItems"></div>

          <div class="summary-totals">
            <div class="summary-row">
