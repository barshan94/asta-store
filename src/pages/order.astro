          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>WHATSAPP</span>
      </a>
    </div>




    <script type="module">
  // 1. Load Supabase from CDN
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

  // 2. Put your real keys here
  const supabase = createClient(
    'https://ryfufhtymvjeveppwjoj.supabase.co',          // ← Your Project URL
    'sb_publishable_nzsU-ZYMEiOz1hxfsC6Spw_GXfaaVfw' // ← Your anon public key
  );

  // 3. Rest of your code
  const cart = JSON.parse(localStorage.getItem('asta_cart')) || [];

  if (cart.length === 0) {
    window.location.href = '/';
  }

  const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
  document.getElementById('cartCount').textContent = totalItems;

  let subtotal = 0;
  cart.forEach(item => {
    subtotal += item.price * item.quantity;
  });

  let delivery = 80;
  const districtSelect = document.getElementById('district');

  function updateTotals() {
    const isDhaka = districtSelect.value === 'Dhaka' || districtSelect.value === '';
    delivery = isDhaka ? 80 : 130;

    document.getElementById('deliveryLabel').textContent = isDhaka ? 'inside Dhaka' : 'outside Dhaka';
    document.getElementById('summaryDelivery').textContent = `৳${delivery}`;
    document.getElementById('summarySubtotal').textContent = `৳${subtotal.toLocaleString()}`;
    document.getElementById('summaryTotal').textContent = `৳${(subtotal + delivery).toLocaleString()}`;
    document.getElementById('placeOrderBtn').textContent = `PLACE ORDER · ৳${(subtotal + delivery).toLocaleString()}`;
  }

  // Render summary
  const summaryContainer = document.getElementById('summaryItems');
  summaryContainer.innerHTML = cart.map(item => {
    const lineTotal = item.price * item.quantity;
    return `
      <div class="summary-item">
        <img src="${item.image}" alt="${item.name}" class="summary-img" />
        <div class="summary-info">
          <div class="summary-name">${item.name}</div>
          <div class="summary-meta">${item.variant} · ${item.quantity}</div>
        </div>
        <div class="summary-price">৳${lineTotal.toLocaleString()}</div>
      </div>
    `;
  }).join('');

  updateTotals();
  districtSelect.addEventListener('change', updateTotals);

  // Form submit
  document.getElementById('orderForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const form = e.target;
    const fullName = form.fullName.value.trim();
    const phone = form.phone.value.trim();
    const district = form.district.value;
    const address = form.address.value.trim();
    const payment = form.payment.value;
    const email = form.email.value.trim();
    const notes = form.notes.value.trim();

    const errorEl = document.getElementById('formError');
    const button = document.getElementById('placeOrderBtn');

    if (!fullName || !phone || !address || !district) {
      errorEl.textContent = 'Please fill in your name, phone and full address.';
      errorEl.style.display = 'block';
      return;
    }

    errorEl.style.display = 'none';

    const orderId = 'AB-' + Math.floor(1000 + Math.random() * 9000);
    const deliveryCost = district === 'Dhaka' ? 80 : 130;
    const total = subtotal + deliveryCost;

    button.disabled = true;
    button.textContent = 'PLACING ORDER...';

    const { data, error } = await supabase
      .from('orders')
      .insert([{
        order_id: orderId,
        full_name: fullName,
        phone: phone,
        email: email || null,
        district: district,
        address: address,
        payment: payment,
        notes: notes || null,
        items: cart,
        subtotal: subtotal,
        delivery: deliveryCost,
        total: total
      }]);

    if (error) {
      console.error(error);
      button.disabled = false;
      button.textContent = `PLACE ORDER · ৳${total.toLocaleString()}`;
      errorEl.textContent = 'Something went wrong. Please try again.';
      errorEl.style.display = 'block';
      return;
    }

    // Success → save for thank-you page
    localStorage.setItem('asta_last_order', JSON.stringify({
      orderId,
      fullName,
      phone,
      email,
      district,
      address,
      payment,
      notes,
      items: cart,
      subtotal,
      delivery: deliveryCost,
      total
    }));

    localStorage.removeItem('asta_cart');
    window.location.href = '/thank-you';
  });
</script>


   
