---
const title = "ASTA — Handmade Leather";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    
    <!-- ========== HEADER ========== -->
    <header class="header">
      <div class="header-inner">
        <div class="double-lines"></div>
        <div class="header-content">
          <div class="logo-wrapper">
            <div class="logo-icon">
              <img src="/images/logo.jpg" alt="ASTA Logo" class="logo-img" />
            </div>
            <div class="logo">ASTA</div>
          </div>

          <div class="right-side">
            <a href="https://www.facebook.com/astabagsbd" target="_blank" rel="noopener noreferrer">
              FACEBOOK
            </a>

            <!-- Correct cart button with icon -->
            <button id="cartHeaderBtn" type="button" class="cart-header-btn">
              <svg class="cart-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                <line x1="3" y1="6" x2="21" y2="6"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
              <span>CART <span id="cartCount">0</span></span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <div class="info-bar">
      <span>EDITION NO. 04</span>
      <span>HANDMADE LEATHER · DHAKA</span>
      <span>CASH ON DELIVERY</span>
      <span>EXCHANGE WITHIN THREE DAYS</span>
    </div>

    <!-- ========== HERO ========== -->
    <section class="hero">
      <div class="hero-text">
        <h1>
          Crafted to<br />
          stand<br />
          the test<br />
          of time
        </h1>
        <p>
          Croc-embossed leather, cut and stitched in small
          batches from Dhaka. Four bags in this edition.
          Order below, pay the rider or send bKash, and we
          confirm every order by hand on WhatsApp before
          it leaves the shop.
        </p>
        <div class="hero-buttons">
          <a href="#edition">SEE THE EDITION</a>
          <a href="https://api.whatsapp.com/send/?phone=%2B8801577488708&text&type=phone_number&app_absent=0" target="_blank" rel="noopener noreferrer">
            ASK ON WHATSAPP
          </a>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/hero.jpg" alt="Asta handmade leather bag" />
      </div>
    </section>

    <!-- ========== STATS ========== -->
    <section class="stats">
      <div class="stat">
        <span class="stat-label">Bags in this edition</span>
        <span class="dots"></span>
        <strong>04</strong>
      </div>
      <div class="stat">
        <span class="stat-label">Delivery inside Dhaka</span>
        <span class="dots"></span>
        <strong>৳80</strong>
      </div>
      <div class="stat">
        <span class="stat-label">Exchange window, days</span>
        <span class="dots"></span>
        <strong>3</strong>
      </div>
      <div class="stat">
        <span class="stat-label">Card gateways used</span>
        <span class="dots"></span>
        <strong>0</strong>
      </div>
    </section>

    <!-- ========== PRODUCTS ========== -->
    <section class="edition" id="edition">
      <div class="edition-heading">
        <h2>The edition</h2>
        <span>FOUR BAGS · IN STOCK TODAY</span>
      </div>

      <div class="products">
        <article class="product-card" data-id="sahara-croc" data-name="Sahara Croc Shoulder" data-price="2450" data-image="/images/sahara.jpg">
          <div class="product-image">
            <img src="/images/sahara.jpg" alt="Sahara Croc Shoulder" />
          </div>
          <div class="product-info">
            <div class="product-header-line">
              <span class="product-number">01</span>
              <span class="product-badge">BESTSELLER</span>
            </div>
            <h3 class="product-title">Sahara Croc Shoulder</h3>
            <p class="product-description">Croc-embossed tan body, maroon trim, adjustable shoulder strap.</p>
            <div class="product-price">৳2,450</div>
            <div class="colour-field">
              <label for="colour-sahara">COLOUR</label>
              <select id="colour-sahara" class="product-variant">
                <option>Tan / Maroon</option>
                <option>All Maroon</option>
              </select>
            </div>
            <button class="add-to-cart-btn" type="button">ADD TO CART</button>
          </div>
        </article>

        <article class="product-card" data-id="ember-croc" data-name="Ember Croc Sling" data-price="2150" data-image="/images/ember.jpg">
          <div class="product-image">
            <img src="/images/ember.jpg" alt="Ember Croc Sling" />
          </div>
          <div class="product-info">
            <div class="product-header-line">
              <span class="product-number">02</span>
            </div>
            <h3 class="product-title">Ember Croc Sling</h3>
            <p class="product-description">Compact sling, turn-lock flap, fully lined interior.</p>
            <div class="product-price">৳2,150</div>
            <div class="colour-field">
              <label for="colour-ember">COLOUR</label>
              <select id="colour-ember" class="product-variant">
                <option>Tan / Maroon</option>
                <option>All Maroon</option>
              </select>
            </div>
            <button class="add-to-cart-btn" type="button">ADD TO CART</button>
          </div>
        </article>

        <article class="product-card" data-id="dune-mini" data-name="Dune Mini Crossbody" data-price="1890" data-image="/images/dune.jpg">
          <div class="product-image">
            <img src="/images/dune.jpg" alt="Dune Mini Crossbody" />
          </div>
          <div class="product-info">
            <div class="product-header-line">
              <span class="product-number">03</span>
              <span class="product-badge">NEW</span>
            </div>
            <h3 class="product-title">Dune Mini Crossbody</h3>
            <p class="product-description">Everyday mini — phone, wallet, keys, nothing spare.</p>
            <div class="product-price">৳1,890</div>
            <div class="colour-field">
              <label for="colour-dune">COLOUR</label>
              <select id="colour-dune" class="product-variant">
                <option>Sand</option>
                <option>Tan / Maroon</option>
              </select>
            </div>
            <button class="add-to-cart-btn" type="button">ADD TO CART</button>
          </div>
        </article>

        <article class="product-card" data-id="atlas-croc" data-name="Atlas Croc Tote" data-price="2950" data-image="/images/atlas.jpg">
          <div class="product-image">
            <img src="/images/atlas.jpg" alt="Atlas Croc Tote" />
          </div>
          <div class="product-info">
            <div class="product-header-line">
              <span class="product-number">04</span>
            </div>
            <h3 class="product-title">Atlas Croc Tote</h3>
            <p class="product-description">Roomier cut for work days, reinforced base and corners.</p>
            <div class="product-price">৳2,950</div>
            <div class="colour-field">
              <label for="colour-atlas">COLOUR</label>
              <select id="colour-atlas" class="product-variant">
                <option>Tan / Maroon</option>
                <option>All Maroon</option>
              </select>
            </div>
            <button class="add-to-cart-btn" type="button">ADD TO CART</button>
          </div>
        </article>
      </div>
    </section>

    <!-- ========== TESTIMONIAL ========== -->
    <section class="testimonial">
      <div class="testimonial-image">
        <img src="/images/ember.jpg" alt="Ember Croc Sling" />
      </div>
      <div class="testimonial-content">
        <blockquote>
          “Ordered on Friday, delivered Sunday morning,
          and the stitching is better than the shop bags
          at twice the price.”
        </blockquote>
        <p>— Nusrat J., Dhanmondi</p>
      </div>
    </section>

    <!-- ========== ORDERING ========== -->
    <section class="ordering">
      <div class="ordering-intro">
        <h2>How ordering works</h2>
        <p>
          No card gateway, no account. You fill the coupon,
          we call to confirm, and you pay the rider — or send bKash
          and write the reference on the form.
        </p>
      </div>
      <div class="ordering-steps">
        <div class="ordering-step">
          <strong>01</strong>
          <p>Add the bag and the colour you want to the slip.</p>
        </div>
        <div class="ordering-step">
          <strong>02</strong>
          <p>Fill the coupon — name, phone, address, and how you are paying.</p>
        </div>
        <div class="ordering-step">
          <strong>03</strong>
          <p>We confirm on WhatsApp, then deliver in one to three days inside Dhaka.</p>
        </div>
      </div>
    </section>

    <!-- ========== FOOTER ========== -->
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-left">ASTA BAGS · DHAKA, BANGLADESH</div>
        <div class="footer-right">
          <a href="https://www.facebook.com/astabagsbd" target="_blank" rel="noopener noreferrer">FACEBOOK</a>
          <a href="https://api.whatsapp.com/send/?phone=%2B8801577488708" target="_blank" rel="noopener noreferrer">+880 1577 488708</a>
        </div>
      </div>
    </footer>

    <!-- ========== FLOATING BUTTONS ========== -->
    <div class="floating-buttons">
      <a href="https://www.facebook.com/astabagsbd" target="_blank" rel="noopener noreferrer" class="float-btn fb-btn" aria-label="Facebook">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
      </a>
      <a href="https://api.whatsapp.com/send/?phone=%2B8801577488708" target="_blank" rel="noopener noreferrer" class="float-btn wa-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>WHATSAPP</span>
      </a>
    </div>

    <!-- ========== CART BACKDROP (only one) ========== -->
    <div class="cart-backdrop" id="cartBackdrop"></div>

    <!-- ========== CART DRAWER (only one) ========== -->
    <aside class="cart-drawer" id="cartDrawer">
      <div class="double-lines cart-double-lines"></div>

      <div class="cart-header">
        <h2>Order slip</h2>
        <button class="close-btn" type="button">CLOSE</button>
      </div>

      <div class="cart-items" id="cartItems"></div>

      <div class="cart-footer">
        <div class="subtotal-row">
          <span>Subtotal</span>
          <span class="subtotal-amount" id="cartSubtotal">৳0</span>
        </div>
        <button class="buy-now-btn" type="button">BUY NOW</button>
        <p class="delivery-note">Delivery added at the coupon · Dhaka ৳80, outside ৳130</p>
      </div>
    </aside>

    <!-- ========== SCRIPT ========== -->
    <script is:inline>
      let cart = JSON.parse(localStorage.getItem('asta_cart')) || [];

      function saveCart() {
        localStorage.setItem('asta_cart', JSON.stringify(cart));
      }

      function updateCartButton() {
        const count = cart.reduce((sum, item) => sum + item.quantity, 0);
        const el = document.getElementById('cartCount');
        if (el) el.textContent = count;
      }

      function openCart() {
        document.getElementById('cartDrawer').classList.add('active');
        document.getElementById('cartBackdrop').classList.add('active');
      }

      function closeCart() {
        document.getElementById('cartDrawer').classList.remove('active');
        document.getElementById('cartBackdrop').classList.remove('active');
      }

      function toggleCart() {
        const drawer = document.getElementById('cartDrawer');
        if (drawer.classList.contains('active')) {
          closeCart();
        } else {
          openCart();
        }
      }

      function addToCart(id, name, price, variant, image) {
        const existing = cart.find(item => item.id === id && item.variant === variant);
        if (existing) {
          existing.quantity += 1;
        } else {
          cart.push({ id, name, price, variant, image, quantity: 1 });
        }
        saveCart();
        renderCart();
        openCart();
      }

      function updateQuantity(id, variant, change) {
        const item = cart.find(i => i.id === id && i.variant === variant);
        if (!item) return;
        item.quantity += change;
        if (item.quantity <= 0) {
          cart = cart.filter(i => !(i.id === id && i.variant === variant));
        }
        saveCart();
        renderCart();
      }

      function removeItem(id, variant) {
        cart = cart.filter(i => !(i.id === id && i.variant === variant));
        saveCart();
        renderCart();
      }

      function renderCart() {
        const container = document.getElementById('cartItems');
        const subtotalEl = document.getElementById('cartSubtotal');
        updateCartButton();

        if (cart.length === 0) {
          container.innerHTML = '<p class="cart-empty">Your cart is empty.</p>';
          subtotalEl.textContent = '৳0';
          return;
        }

        let total = 0;
        container.innerHTML = cart.map(item => {
          const lineTotal = item.price * item.quantity;
          total += lineTotal;
          return `
            <div class="cart-item" data-id="${item.id}" data-variant="${item.variant}">
              <div class="cart-item-img-wrap">
                <img src="${item.image}" alt="${item.name}" class="cart-item-img" />
              </div>
              <div class="cart-item-details">
                <div class="cart-item-top">
                  <h3 class="cart-item-name">${item.name}</h3>
                  <span class="cart-item-line-total">৳${lineTotal.toLocaleString()}</span>
                </div>
                <p class="cart-item-meta">${item.variant} · ৳${item.price.toLocaleString()}</p>
                <div class="cart-item-actions">
                  <div class="quantity-selector">
                    <button type="button" class="qty-btn" data-change="-1">−</button>
                    <span>${item.quantity}</span>
                    <button type="button" class="qty-btn" data-change="1">+</button>
                  </div>
                  <button type="button" class="remove-btn">REMOVE</button>
                </div>
              </div>
            </div>
          `;
        }).join('');

        subtotalEl.textContent = `৳${total.toLocaleString()}`;
      }

      document.addEventListener('DOMContentLoaded', () => {
        renderCart();

        // CART button
        document.getElementById('cartHeaderBtn').addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          toggleCart();
        });

        // CLOSE button
        document.querySelector('.close-btn').addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          closeCart();
        });

        // Backdrop click → close
        document.getElementById('cartBackdrop').addEventListener('click', () => {
          closeCart();
        });

        // Quantity & Remove
        document.getElementById('cartItems').addEventListener('click', (e) => {
          const qtyBtn = e.target.closest('.qty-btn');
          if (qtyBtn) {
            const row = qtyBtn.closest('.cart-item');
            if (!row) return;
            updateQuantity(row.dataset.id, row.dataset.variant, parseInt(qtyBtn.dataset.change, 10));
            return;
          }

          const removeBtn = e.target.closest('.remove-btn');
          if (removeBtn) {
            const row = removeBtn.closest('.cart-item');
            if (!row) return;
            removeItem(row.dataset.id, row.dataset.variant);
          }
        });

        // BUY NOW
        document.querySelector('.buy-now-btn').addEventListener('click', () => {
  if (cart.length === 0) {
    alert('Your cart is empty.');
    return;
  }
  window.location.href = '/order';
});

        // Add to cart
        document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const card = e.target.closest('.product-card');
            if (!card) return;
            const id = card.dataset.id;
            const name = card.dataset.name;
            const price = parseInt(card.dataset.price, 10);
            const image = card.dataset.image;
            const select = card.querySelector('.product-variant');
            const variant = select ? select.value : 'Default';
            addToCart(id, name, price, variant, image);
          });
        });
      });
    </script>

    <!-- ========== STYLES ========== -->
    <style is:global>
      body {
        margin: 0;
        background: #f4f3ef;
        color: #151515;
        font-family: Georgia, serif;
      }

      .header {
        width: 100%;
        box-sizing: border-box;
        padding: 40px 40px 0 40px;
      }

      .header-inner { max-width: 100%; }

      .double-lines {
        height: 2px;
        border-top: 1px solid #151515;
        border-bottom: 1px solid #151515;
        margin-bottom: 24px;
      }

      .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 24px;
        border-bottom: 1px solid #bdbbb5;
      }

      .logo-wrapper {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .logo-icon {
        width: 70px;
        height: 70px;
        background-color: #e6ff2b;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .logo-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .logo {
        font-size: 58px;
        font-weight: 700;
        letter-spacing: 4px;
        line-height: 1;
      }

      .info-bar {
        display: flex;
        justify-content: space-between;
        padding: 12px 40px;
        border-bottom: 1px solid #bdbbb5;
        font-family: Arial, sans-serif;
        font-size: 10px;
        letter-spacing: 1.5px;
        color: #666;
      }

      .right-side {
        display: flex;
        align-items: center;
        gap: 30px;
      }

      .right-side a {
        text-decoration: none;
        color: #008ca3;
        font-family: Arial, sans-serif;
        font-size: 12px;
        letter-spacing: 1.5px;
      }

      /* Cart header button */
      .cart-header-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        border: 1px solid #999;
        padding: 11px 18px;
        font-family: Arial, sans-serif;
        font-size: 12px;
        letter-spacing: 1.2px;
        color: #151515;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
      }

      .cart-header-btn:hover {
        border-color: #151515;
        background: rgba(0,0,0,0.03);
      }

      .cart-icon {
        flex-shrink: 0;
        width: 15px;
        height: 15px;
        stroke: #151515;
      }

      .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 70px;
        padding: 90px 40px;
        max-width: 1400px;
        margin: 0 auto;
        align-items: center;
      }

      .hero-text h1 {
        font-size: clamp(60px, 7vw, 100px);
        line-height: 0.95;
        font-weight: 600;
        letter-spacing: -3px;
        margin: 0 0 35px;
      }

      .hero-text p {
        max-width: 520px;
        color: #666;
        font-family: Arial, sans-serif;
        font-size: 15px;
        line-height: 1.7;
        margin-bottom: 30px;
      }

      .hero-buttons {
        display: flex;
        gap: 10px;
      }

      .hero-buttons a {
        display: inline-block;
        padding: 15px 22px;
        border: 1px solid #999;
        font-family: Arial, sans-serif;
        font-size: 11px;
        letter-spacing: 1px;
        text-decoration: none;
      }

      .hero-buttons a:first-child {
        background: #008ca3;
        border-color: #008ca3;
        color: white;
      }

      .hero-image {
        width: 100%;
        overflow: hidden;
      }

      .hero-image img {
        display: block;
        width: 100%;
        height: auto;
        filter: grayscale(100%) brightness(1.15) contrast(0.75);
        opacity: 0.55;
        transition: filter 0.6s ease, opacity 0.6s ease;
      }

      .hero-image:hover img {
        filter: grayscale(0%) brightness(1) contrast(1);
        opacity: 1;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin: 0 40px;
        border-top: 1px solid #bdbbb5;
        border-bottom: 1px solid #bdbbb5;
      }

      .stat {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        padding: 18px 20px 18px 0;
        font-family: Arial, sans-serif;
        font-size: 12px;
      }

      .stat-label {
        white-space: nowrap;
        color: #666;
      }

      .dots {
        flex: 1;
        min-width: 20px;
        border-bottom: 1px dotted #999;
        height: 1px;
      }

      .stat strong {
        font-weight: 400;
        white-space: nowrap;
      }

      .stat:nth-child(4) {
        grid-column: 1;
        grid-row: 2;
      }

      @media (max-width: 700px) {
        .stats {
          grid-template-columns: 1fr;
          margin: 0 20px;
        }
        .stat:nth-child(4) {
          grid-column: auto;
          grid-row: auto;
        }
      }

      .edition {
        padding: 90px 40px;
      }

      .edition-heading {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        border-bottom: 1px solid #bdbbb5;
        padding-bottom: 20px;
      }

      .edition-heading h2 {
        margin: 0;
        font-size: 58px;
        font-weight: 500;
      }

      .edition-heading span {
        font-family: Arial, sans-serif;
