---
const title = "ASTA — Handmade Leather";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="header">
      <div class="header-inner">

        <div class="double-lines"></div>

        <div class="header-content">

          <div class="logo-wrapper">
            <div class="logo-icon">
              <img
                id="siteLogo"
                
                alt="ASTA Logo"
                class="logo-img"
              />
            </div>

            <div class="logo" id="siteName">ASTA</div>
          </div>

          <div class="right-side">

            <a
              id="headerFacebookLink"
              href="https://www.facebook.com/astabagsbd"
              target="_blank"
              rel="noopener noreferrer"
            >
              FACEBOOK
            </a>

            <button
              id="cartHeaderBtn"
              type="button"
              class="cart-header-btn"
            >
              <svg
                class="cart-icon"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
