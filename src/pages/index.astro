        </svg>

        <span>WHATSAPP</span>

      </a>

    </div>


    <!-- =====================================================
         CART BACKDROP
    ====================================================== -->

    <div
      class="cart-backdrop"
      id="cartBackdrop"
    ></div>


    <!-- =====================================================
         CART DRAWER
    ====================================================== -->

    <aside
      class="cart-drawer"
      id="cartDrawer"
    >

      <div class="double-lines cart-double-lines"></div>

      <div class="cart-header">

        <h2>Order slip</h2>

        <button
          class="close-btn"
          type="button"
        >
          CLOSE
        </button>

      </div>


      <div
        class="cart-items"
        id="cartItems"
      ></div>


      <div class="cart-footer">

        <div class="subtotal-row">
          <span>Subtotal</span>
          <span
            class="subtotal-amount"
            id="cartSubtotal"
          >
            ৳0
          </span>
        </div>

        <button
          class="buy-now-btn"
          type="button"
        >
          BUY NOW
        </button>

        <p class="delivery-note">
          <span id="deliveryNote">Delivery added at the coupon · Dhaka ৳80, outside ৳130</span>
        </p>

      </div>

    </aside>


    <!-- =====================================================
         CART SCRIPT
    ====================================================== -->

    <script is:inline>

      let cart =
        JSON.parse(localStorage.getItem("asta_cart")) || [];


      function saveCart() {
        localStorage.setItem(
          "asta_cart",
          JSON.stringify(cart)
        );
      }


      function updateCartButton() {

        const count = cart.reduce(
          (sum, item) => sum + item.quantity,
          0
        );

        const el =
          document.getElementById("cartCount");

        if (el) {
          el.textContent = count;
        }
      }


      function openCart() {

        document
          .getElementById("cartDrawer")
          .classList.add("active");

        document
          .getElementById("cartBackdrop")
          .classList.add("active");

        document.body.classList.add("cart-open");
      }


      function closeCart() {

        document
          .getElementById("cartDrawer")
          .classList.remove("active");

        document
          .getElementById("cartBackdrop")
          .classList.remove("active");

        document.body.classList.remove("cart-open");
      }


      function toggleCart() {

        const drawer =
          document.getElementById("cartDrawer");

        if (drawer.classList.contains("active")) {
          closeCart();
        } else {
          openCart();
        }
      }


      function addToCart(
        id,
        name,
        price,
        variant,
        image
      ) {

        const existing = cart.find(
          item =>
            item.id === id &&
            item.variant === variant
        );


        if (existing) {

          existing.quantity += 1;

        } else {

          cart.push({
            id,
            name,
            price,
            variant,
            image,
            quantity: 1
          });

        }


        saveCart();
        renderCart();
        openCart();
      }


      function updateQuantity(
        id,
        variant,
        change
      ) {

        const item = cart.find(
          i =>
            i.id === id &&
            i.variant === variant
        );

        if (!item) return;


        item.quantity += change;


        if (item.quantity <= 0) {

          cart = cart.filter(
            i =>
              !(
                i.id === id &&
                i.variant === variant
              )
          );

        }


        saveCart();
        renderCart();
      }


      function removeItem(id, variant) {

        cart = cart.filter(
          i =>
            !(
              i.id === id &&
              i.variant === variant
            )
        );

        saveCart();
        renderCart();
      }


      function renderCart() {

        const container =
          document.getElementById("cartItems");

        const subtotalEl =
          document.getElementById("cartSubtotal");


        updateCartButton();


        if (cart.length === 0) {

          container.innerHTML =
            '<p class="cart-empty">Your cart is empty.</p>';

          subtotalEl.textContent = "৳0";

          return;
        }


        let total = 0;


        container.innerHTML = cart
          .map(item => {

            const lineTotal =
              item.price * item.quantity;

            total += lineTotal;


            return `
              <div
                class="cart-item"
                data-id="${item.id}"
                data-variant="${item.variant}"
              >

                <div class="cart-item-img-wrap">
                  <img
                    src="${item.image}"
                    alt="${item.name}"
                    class="cart-item-img"
                  />
                </div>

                <div class="cart-item-details">

                  <div class="cart-item-top">

                    <h3 class="cart-item-name">
                      ${item.name}
                    </h3>

                    <span class="cart-item-line-total">
                      ৳${lineTotal.toLocaleString()}
                    </span>

                  </div>

                  <p class="cart-item-meta">
                    ${item.variant} ·
                    ৳${item.price.toLocaleString()}
                  </p>

                  <div class="cart-item-actions">

                    <div class="quantity-selector">

                      <button
                        type="button"
                        class="qty-btn"
                        data-change="-1"
                      >
                        −
                      </button>

                      <span>${item.quantity}</span>

                      <button
                        type="button"
                        class="qty-btn"
                        data-change="1"
                      >
                        +
                      </button>

                    </div>

                    <button
                      type="button"
                      class="remove-btn"
                    >
                      REMOVE
                    </button>

                  </div>

                </div>

              </div>
            `;

          })
          .join("");


        subtotalEl.textContent =
          `৳${total.toLocaleString()}`;
      }


      document.addEventListener(
        "DOMContentLoaded",
        () => {

          renderCart();


          /* CART */

          document
            .getElementById("cartHeaderBtn")
            .addEventListener(
              "click",
              event => {

                event.preventDefault();
                event.stopPropagation();

                toggleCart();
              }
            );


          /* CLOSE */

          document
            .querySelector(".close-btn")
            .addEventListener(
              "click",
              event => {

                event.preventDefault();
                event.stopPropagation();

                closeCart();
              }
            );


          /* BACKDROP */

          document
            .getElementById("cartBackdrop")
            .addEventListener(
              "click",
              closeCart
            );


          /* ESCAPE KEY */

          document.addEventListener(
            "keydown",
            event => {

              if (
                event.key === "Escape"
              ) {
                closeCart();
              }

            }
          );


          /* QUANTITY + REMOVE */

          document
            .getElementById("cartItems")
            .addEventListener(
              "click",
              event => {

                const qtyBtn =
                  event.target.closest(
                    ".qty-btn"
                  );


                if (qtyBtn) {

                  const row =
                    qtyBtn.closest(
                      ".cart-item"
                    );

                  if (!row) return;


                  updateQuantity(
                    row.dataset.id,
                    row.dataset.variant,
                    parseInt(
                      qtyBtn.dataset.change,
                      10
                    )
                  );

                  return;
                }


                const removeBtn =
                  event.target.closest(
                    ".remove-btn"
                  );


                if (removeBtn) {

                  const row =
                    removeBtn.closest(
                      ".cart-item"
                    );

                  if (!row) return;


                  removeItem(
                    row.dataset.id,
                    row.dataset.variant
                  );
                }

              }
            );


          /* BUY NOW */

          document
            .querySelector(".buy-now-btn")
            .addEventListener(
              "click",
              () => {

                if (cart.length === 0) {

                  alert(
                    "Your cart is empty."
                  );

                  return;
                }


                window.location.href =
                  "/order";
              }
            );


          /* ADD TO CART */

          document
            .querySelectorAll(
              ".add-to-cart-btn"
            )
            .forEach(btn => {

              btn.addEventListener(
                "click",
                event => {

                  const card =
                    event.target.closest(
                      ".product-card"
                    );

                  if (!card) return;


                  const id =
                    card.dataset.id;

                  const name =
                    card.dataset.name;

                  const price =
                    parseInt(
                      card.dataset.price,
                      10
                    );

                  const image =
                    card.dataset.image;


                  const select =
                    card.querySelector(
                      ".product-variant"
                    );


                  const variant =
                    select
                      ? select.value
                      : "Default";


                  addToCart(
                    id,
                    name,
                    price,
                    variant,
                    image
                  );

                }
              );

            });

        }
      );

    </script>

    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

      const supabase = createClient(
        'https://ryfufhtymvjeveppwjoj.supabase.co',
        'sb_publishable_nzsU-ZYMEiOz1hxfsC6Spw_GXfaaVfw'
      );

      async function loadProducts() {
        const grid = document.getElementById('productsGrid');
        if (!grid) return;

        const { data: products, error } = await supabase
          .from('products')
          .select('*')
          .order('sort_order', { ascending: true });

        if (error || !products || products.length === 0) {
          grid.innerHTML = `<p style="padding:40px;text-align:center;color:#777;grid-column:1/-1;">No products available.</p>`;
          if (error) console.error('Products error:', error);
          return;
        }

        grid.innerHTML = products.map((product, index) => {
          const colours = Array.isArray(product.colours) && product.colours.length
            ? product.colours
            : ['Default'];
          const colourOptions = colours
            .map(c => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`)
            .join('');
          const number = String(index + 1).padStart(2, '0');
          const image = product.image_url || '';
          return `
            <article class="product-card"
              data-id="${escapeHtml(product.id)}"
              data-name="${escapeHtml(product.name || '')}"
              data-price="${Number(product.price) || 0}"
              data-image="${escapeHtml(image)}">
              <div class="product-image">
                ${image
                  ? `<img src="${escapeHtml(image)}" alt="${escapeHtml(product.name || '')}" />`
                  : `<div style="width:100%;height:100%;background:#e8e6e0;display:flex;align-items:center;justify-content:center;color:#999;">No Image</div>`}
              </div>
              <div class="product-info">
                <div class="product-header-line">
                  <span class="product-number">${number}</span>
                  ${product.is_bestseller ? '<span class="product-badge">BESTSELLER</span>' : ''}
                  ${product.is_new ? '<span class="product-badge">NEW</span>' : ''}
                </div>
                <h3 class="product-title">${escapeHtml(product.name || '')}</h3>
                <p class="product-description">${escapeHtml(product.description || '')}</p>
                <div class="product-price">৳${Number(product.price || 0).toLocaleString()}</div>
                <div class="colour-field">
                  <label>COLOUR</label>
                  <select class="product-variant">${colourOptions}</select>
                </div>
                <button class="add-to-cart-btn" type="button">ADD TO CART</button>
              </div>
            </article>`;
        }).join('');

        grid.querySelectorAll('.add-to-cart-btn').forEach(btn => {
          btn.addEventListener('click', event => {
            const card = event.currentTarget.closest('.product-card');
            if (!card || typeof window.addToCart !== 'function') return;
            const select = card.querySelector('.product-variant');
            window.addToCart(
              card.dataset.id,
              card.dataset.name,
              Number(card.dataset.price),
              select ? select.value : 'Default',
              card.dataset.image
            );
          });
        });
      }

      function escapeHtml(value) {
        return String(value ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      loadProducts();
    </script>


    <!-- =====================================================
         SITE SETTINGS
    ====================================================== -->
    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

      const supabase = createClient(
        'https://ryfufhtymvjeveppwjoj.supabase.co',
        'sb_publishable_nzsU-ZYMEiOz1hxfsC6Spw_GXfaaVfw'
      );

      function setText(id, value) {
        const el = document.getElementById(id);
        if (el && value !== undefined && value !== null && value !== '') {
          el.textContent = value;
        }
      }

      function setHref(id, value) {
        const el = document.getElementById(id);
        if (el && value) el.href = value;
      }

function whatsappUrl(settings) {
  if (settings.whatsappUrl) return settings.whatsappUrl;

  if (settings.whatsappNumber) {
    const number = String(settings.whatsappNumber).replace(/[^0-9]/g, '');
    return number ? `https://wa.me/${number}` : '';
  }

  return '';
}


async function loadSiteSettings() {
  const { data, error } = await supabase
    .from('site_settings')
    .select('key, value');

  if (error) {
    console.error('Site settings error:', error);
    return;
  }

  const settings = {};
  (data || []).forEach(row => {
    settings[row.key] = row.value;
  });

  console.log("SITE SETTINGS FROM DATABASE:", settings);

  // Support both Admin camelCase keys and old snake_case keys
  const getSetting = (camelCase, snakeCase) =>
    settings[camelCase] || settings[snakeCase] || '';

  document.title =
    getSetting('pageTitle') || document.title;

  setText('siteName', getSetting('siteName'));

  // Logo
  const logoUrl = getSetting('logoUrl');
  if (logoUrl) {
    const logo = document.getElementById('siteLogo');
    if (logo) logo.src = logoUrl;
  }

  // Info bars
  setText('infoBar1', getSetting('editionLabel'));
  setText('infoBar2', getSetting('infoBar2'));
  setText('infoBar3', getSetting('infoBar3'));
  setText('infoBar4', getSetting('infoBar4'));

  // Hero
  setText('heroTitle', getSetting('heroTitle'));
  setText(
    'heroDescription',
    getSetting('heroDescription')
  );

 const heroButton1Text = getSetting('heroButton1Text');

  if (heroButton1Text) {
    setText('heroButton1', heroButton1Text);
  }

  setHref(
    'heroButton1',
    getSetting('heroButton1Link')
  );

 const heroButton2Text = getSetting('heroButton2Text');

  if (heroButton2Text) {
    setText('heroButton2', heroButton2Text);
  }

  const waUrl = whatsappUrl(settings);

  setHref(
    'heroButton2',
    getSetting('heroButton2Link') || waUrl
  );

  // Hero image
  const heroUrl = getSetting('heroUrl');

  if (heroUrl) {
    const hero = document.getElementById('heroImage');
    if (hero) hero.src = heroUrl;
  }

  // Stats
  for (let i = 1; i <= 4; i++) {
    setText(
      `stat${i}Value`,
      getSetting(`stat${i}Value`)
    );

    setText(
      `stat${i}Label`,
      getSetting(`stat${i}Label`)
    );
  }

  // Edition
  setText(
    'editionHeading',
    getSetting('editionHeading')
  );

  setText(
    'editionSubheading',
    getSetting('editionSubheading')
  );

  // Testimonial
 const testimonialImageUrl = getSetting('testimonialImageUrl');

  if (testimonialImageUrl) {
    const img = document.getElementById('testimonialImage');
    if (img) img.src = testimonialImageUrl;
  }

  setText(
    'testimonialQuote',
    getSetting('testimonialQuote')
  );

const testimonialAuthor = getSetting('testimonialAuthor');

const testimonialLocation = getSetting('testimonialLocation');
  if (testimonialAuthor || testimonialLocation) {
    const parts = [];

    if (testimonialAuthor) parts.push(testimonialAuthor);
    if (testimonialLocation) parts.push(testimonialLocation);

    setText(
      'testimonialAttribution',
      `— ${parts.join(', ')}`
    );
  }

  // Ordering
  setText(
    'orderingTitle',
    getSetting('orderingTitle')
  );

  setText(
    'orderingDescription',
    getSetting('orderingDescription')
  );

  for (let i = 1; i <= 3; i++) {
    setText(
      `orderStep${i}Description`,
     getSetting(`orderStep${i}Description`)
    );
  }

  // Footer
  setText(
    'footerText',
    getSetting('footerText')
  );

  // Social links
const facebookUrl = getSetting('facebookUrl');

const footerFacebook = getSetting('footerFacebook');

const footerWhatsapp = getSetting('footerWhatsapp');

const whatsappNumber = getSetting('whatsappNumber');

  setHref('headerFacebookLink', facebookUrl);
  setHref(
    'footerFacebookLink',
    footerFacebook || facebookUrl
  );

  setHref('floatingFacebook', facebookUrl);

  setHref(
    'footerWhatsappLink',
    footerWhatsapp || waUrl
  );

  setHref('floatingWhatsapp', waUrl);

  if (whatsappNumber) {
    const footerWa =
      document.getElementById('footerWhatsappLink');

    if (footerWa) {
      footerWa.textContent = whatsappNumber;
    }
  }

  // Delivery
const deliveryInsideDhaka = getSetting('deliveryInsideDhaka');

const deliveryOutsideDhaka = getSetting('deliveryOutsideDhaka');

  if (deliveryInsideDhaka || deliveryOutsideDhaka) {
    const inside = deliveryInsideDhaka || '80';
    const outside = deliveryOutsideDhaka || '130';

    setText(
      'deliveryNote',
      `Delivery added at the coupon · Dhaka ৳${inside}, outside ৳${outside}`
    );
  }



  // Floating Facebook
const floatingFacebookEnabled = getSetting('floatingFacebookEnabled');

const floatingFb =
  document.getElementById('floatingFacebook');

if (
  floatingFb &&
  (
    floatingFacebookEnabled === false ||
    floatingFacebookEnabled === 'false' ||
    floatingFacebookEnabled === '0'
  )
) {
  floatingFb.style.display = 'none';
}




  // Floating WhatsApp
const floatingWhatsappEnabled = getSetting('floatingWhatsappEnabled');

  const floatingWa =
    document.getElementById('floatingWhatsapp');

  if (
    floatingWa &&
    (
      floatingWhatsappEnabled === false ||
      floatingWhatsappEnabled === 'false' ||
      floatingWhatsappEnabled === '0'
    )
  ) {
    floatingWa.style.display = 'none';
  }
}

loadSiteSettings();


    </script>


