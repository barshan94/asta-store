                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <path d="M16 10a4 4 0 0 1-8 0" />
              </svg>

              <span>
                CART <span id="cartCount">0</span>
              </span>
            </button>

          </div>
        </div>
      </div>
    </header>


    <!-- =====================================================
         INFO BAR
    ====================================================== -->

    <div class="info-bar">
      <span id="infoBar1">EDITION NO. 04</span>
      <span id="infoBar2">HANDMADE LEATHER · DHAKA</span>
      <span id="infoBar3">CASH ON DELIVERY</span>
      <span id="infoBar4">EXCHANGE WITHIN THREE DAYS</span>
    </div>


    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="hero">

      <div class="hero-text">

        <h1 id="heroTitle">Crafted to
stand
the test
of time</h1>

        <p id="heroDescription">Croc-embossed leather, cut and stitched in small batches from Dhaka. Four bags in this edition. Order below, pay the rider or send bKash, and we confirm every order by hand on WhatsApp before it leaves the shop.</p>

        <div class="hero-buttons">
          <a id="heroButton1" href="#edition">SEE THE EDITION</a>
          <a id="heroButton2" href="https://api.whatsapp.com/send/?phone=%2B8801577488708&text&type=phone_number&app_absent=0" target="_blank" rel="noopener noreferrer">ASK ON WHATSAPP</a>
        </div>

      </div>


      <div class="hero-image">
        <img
          id="heroImage"
    
          alt="Asta handmade leather bag"
        />
      </div>

    </section>



    <!-- =====================================================
         STATS
    ====================================================== -->
    <section class="stats">
      <div class="stat">
        <span class="stat-label" id="stat1Label">Bags in this edition</span>
        <span class="dots"></span>
        <strong id="stat1Value">04</strong>
      </div>
      <div class="stat">
        <span class="stat-label" id="stat2Label">Delivery inside Dhaka</span>
        <span class="dots"></span>
        <strong id="stat2Value">৳80</strong>
      </div>
      <div class="stat">
        <span class="stat-label" id="stat3Label">Exchange window, days</span>
        <span class="dots"></span>
        <strong id="stat3Value">3</strong>
      </div>
      <div class="stat">
        <span class="stat-label" id="stat4Label">Card gateways used</span>
        <span class="dots"></span>
        <strong id="stat4Value">0</strong>
      </div>
    </section>

    <!-- =====================================================
         EDITION / PRODUCTS
    ====================================================== -->
    <section class="edition" id="edition">
      <div class="edition-heading">
        <h2 id="editionHeading">The edition</h2>
        <span id="editionSubheading">FOUR BAGS · IN STOCK TODAY</span>
      </div>
      <div class="products" id="productsGrid">
        <p class="products-loading" style="padding:40px;text-align:center;color:#777;grid-column:1/-1;">Loading products...</p>
      </div>
    </section>


    <!-- =====================================================
         TESTIMONIAL
    ====================================================== -->

    <section class="testimonial">

      <div class="testimonial-image">
        <img
          id="testimonialImage"
          src="/images/ember.jpg"
          alt="Customer testimonial"
        />
      </div>

      <div class="testimonial-content">

        <blockquote id="testimonialQuote">“Ordered on Friday, delivered Sunday morning, and the stitching is better than the shop bags at twice the price.”</blockquote>

        <p id="testimonialAttribution">— Nusrat J., Dhanmondi</p>

      </div>

    </section>


    <!-- =====================================================
         ORDERING
    ====================================================== -->

    <section class="ordering">

      <div class="ordering-intro">

        <h2 id="orderingTitle">How ordering works</h2>

        <p id="orderingDescription">No card gateway, no account. You fill the coupon, we call to confirm, and you pay the rider — or send bKash and write the reference on the form.</p>

      </div>


      <div class="ordering-steps">

        <div class="ordering-step">
          <strong>01</strong>
          <p id="orderStep1Description">
            Add the bag and the colour you want to the slip.
          </p>
        </div>

        <div class="ordering-step">
          <strong>02</strong>
          <p id="orderStep2Description">
            Fill the coupon — name, phone, address, and how you are paying.
          </p>
        </div>

        <div class="ordering-step">
          <strong>03</strong>
          <p id="orderStep3Description">
            We confirm on WhatsApp, then deliver in one to three days inside Dhaka.
          </p>
        </div>

      </div>

    </section>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="footer">

      <div class="footer-inner">

        <div class="footer-left" id="footerText">ASTA BAGS · DHAKA, BANGLADESH</div>

        <div class="footer-right">

          <a
