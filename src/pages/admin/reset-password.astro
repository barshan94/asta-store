---
const title = "Reset Password — ASTA Admin";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="login-page">
      <div class="login-box">
        <h1>Set new password</h1>
        <p class="subtitle">Choose a new password for your admin account</p>

        <form id="resetForm" style="display:none;">
          <div class="form-group">
            <label>New password</label>
            <input type="password" id="password" required minlength="6" placeholder="••••••••" />
          </div>
          <div class="form-group">
            <label>Confirm new password</label>
            <input type="password" id="confirmPassword" required minlength="6" placeholder="••••••••" />
          </div>
          <p id="errorMsg" class="error" style="display:none;"></p>
          <button type="submit" id="resetBtn">Update password</button>
        </form>

        <p id="checkingMsg" class="subtitle">Verifying your reset link...</p>

        <p id="invalidLinkMsg" class="error" style="display:none;">
          This password reset link is invalid or has expired. Please request a new one.
        </p>

        <p id="successMsg" class="success" style="display:none;">
          Password updated. Redirecting to sign in...
        </p>

        <div class="links">
          <a href="/admin/forgot-password">Request a new link</a>
          <a href="/admin/login">Back to sign in</a>
        </div>
      </div>
    </div>

    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

      const supabase = createClient(
        'https://ryfufhtymvjeveppwjoj.supabase.co',
        'sb_publishable_nzsU-ZYMEiOz1hxfsC6Spw_GXfaaVfw',
        { auth: { storageKey: 'asta-admin-auth' } }
      );


      const form = document.getElementById('resetForm');
      const checkingMsg = document.getElementById('checkingMsg');
      const invalidLinkMsg = document.getElementById('invalidLinkMsg');
      const errorMsg = document.getElementById('errorMsg');
      const successMsg = document.getElementById('successMsg');
      const btn = document.getElementById('resetBtn');

      let recoveryReady = false;

      function showForm() {
        recoveryReady = true;
        checkingMsg.style.display = 'none';
        invalidLinkMsg.style.display = 'none';
        form.style.display = 'block';
      }

      // This is the key part your flow was missing: Supabase fires a
      // PASSWORD_RECOVERY auth event once it parses the token from the
      // reset-link URL. We wait for that instead of treating "a session
      // exists" as "go straight to the dashboard".
      supabase.auth.onAuthStateChange((event, session) => {
        if (event === 'PASSWORD_RECOVERY' && session) {
          showForm();
        }
      });

      // Fallback in case the event already fired before this listener
      // was attached (can happen depending on redirect timing).
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        showForm();
      } else {
        setTimeout(async () => {
          if (!recoveryReady) {
            const { data: { session: s2 } } = await supabase.auth.getSession();
            if (s2) {
              showForm();
            } else {
              checkingMsg.style.display = 'none';
              invalidLinkMsg.style.display = 'block';
            }
          }
        }, 1500);
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;

        errorMsg.style.display = 'none';

        if (password.length < 6) {
          errorMsg.textContent = 'Password must be at least 6 characters.';
          errorMsg.style.display = 'block';
          return;
        }

        if (password !== confirmPassword) {
          errorMsg.textContent = 'Passwords do not match.';
          errorMsg.style.display = 'block';
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Updating...';

        const { error } = await supabase.auth.updateUser({ password });

        if (error) {
          errorMsg.textContent = error.message;
          errorMsg.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Update password';
          return;
        }

        form.style.display = 'none';
        successMsg.style.display = 'block';

        await supabase.auth.signOut();
        setTimeout(() => {
          window.location.href = '/admin/login';
        }, 1800);
      });
    </script>

    <style>
      body { margin: 0; background: #f4f3ef; font-family: Arial, sans-serif; }
      .login-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
      .login-box { background: white; padding: 40px; border-radius: 8px; width: 100%; max-width: 400px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
      h1 { margin: 0 0 6px; font-family: Georgia, serif; font-size: 28px; }
      .subtitle { color: #666; margin: 0 0 30px; font-size: 14px; }
      .form-group { margin-bottom: 18px; }
      label { display: block; font-size: 12px; letter-spacing: 1px; color: #555; margin-bottom: 6px; }
      input { width: 100%; padding: 12px 14px; border: 1px solid #ddd; border-radius: 4px; font-size: 15px; box-sizing: border-box; }
      button { width: 100%; padding: 14px; background: #151515; color: white; border: none; font-size: 14px; font-weight: 600; letter-spacing: 1px; cursor: pointer; margin-top: 10px; }
      button:disabled { opacity: 0.6; cursor: not-allowed; }
      .error { color: #c44d6a; font-size: 13px; margin: 10px 0; }
      .success { color: #1a7a4c; font-size: 13px; margin: 10px 0; }
      .links { margin-top: 24px; display: flex; justify-content: space-between; font-size: 13px; }
      .links a { color: #008ca3; text-decoration: none; }
    </style>
  </body>
</html>
