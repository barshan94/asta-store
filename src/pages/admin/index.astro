---
const title = "Orders — ASTA Admin";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="admin-layout">
      <!-- Sidebar -->
      <aside class="sidebar">
        <div class="logo">ASTA Admin</div>
<nav>
  <a href="/admin">Orders</a>
  <a href="/admin/products">Products</a>
  <a href="/admin/settings">Settings</a>
</nav>
        <button id="logoutBtn" class="logout-btn">Logout</button>
      </aside>

      <!-- Main Content -->
      <main class="main-content">
        <header class="top-bar">
          <h1>Orders</h1>
          <div class="filters">
            <select id="statusFilter">
              <option value="">All Status</option>
              <option value="pending">Pending</option>
              <option value="confirmed">Confirmed</option>
              <option value="delivered">Delivered</option>
              <option value="cancelled">Cancelled</option>
            </select>
            <input type="text" id="searchInput" placeholder="Search name / phone / order id..." />
          </div>
        </header>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Phone</th>
                <th>Total</th>
                <th>Payment</th>
                <th>Status</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="ordersBody">
              <tr>
                <td colspan="8" style="text-align:center; padding: 40px;">Loading orders...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </main>
    </div>

    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

      const supabase = createClient(
        'https://ryfufhtymvjeveppwjoj.supabase.co',   // ← your URL
        'sb_publishable_nzsU-ZYMEiOz1hxfsC6Spw_GXfaaVfw'                         // ← your anon key
      );

      // Check login
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        window.location.href = '/admin/login';
      }

      let allOrders = [];

      // Load orders
      async function loadOrders() {
        const { data, error } = await supabase
          .from('orders')
          .select('*')
          .order('created_at', { ascending: false });

        if (error) {
          console.error(error);
          document.getElementById('ordersBody').innerHTML = `
            <tr><td colspan="8" style="text-align:center;color:#c44d6a;">Failed to load orders</td></tr>
          `;
          return;
        }

        allOrders = data || [];
        renderOrders(allOrders);
      }

      function renderOrders(orders) {
        const tbody = document.getElementById('ordersBody');

        if (orders.length === 0) {
          tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;padding:40px;">No orders found</td></tr>`;
          return;
        }

        tbody.innerHTML = orders.map(order => `
          <tr data-id="${order.id}">
            <td><strong>${order.order_id}</strong></td>
            <td>${order.full_name}</td>
            <td>${order.phone}</td>
            <td>৳${Number(order.total).toLocaleString()}</td>
            <td>${order.payment}</td>
            <td>
              <select class="status-select" data-id="${order.id}">
                <option value="pending" ${order.status === 'pending' ? 'selected' : ''}>Pending</option>
                <option value="confirmed" ${order.status === 'confirmed' ? 'selected' : ''}>Confirmed</option>
                <option value="delivered" ${order.status === 'delivered' ? 'selected' : ''}>Delivered</option>
                <option value="cancelled" ${order.status === 'cancelled' ? 'selected' : ''}>Cancelled</option>
              </select>
            </td>
            <td>${order.created_at ? new Date(order.created_at).toLocaleDateString() : '-'}</td>
            <td>
              <button class="delete-btn" data-id="${order.id}">Delete</button>
            </td>
          </tr>
        `).join('');

        // Status change
// Status change
document.querySelectorAll('.status-select').forEach(select => {
  select.addEventListener('change', async (e) => {
    const id = e.target.dataset.id;
    const newStatus = e.target.value;

    // Disable while saving
    e.target.disabled = true;

    const { error } = await supabase
      .from('orders')
      .update({ status: newStatus })
      .eq('id', id);

    e.target.disabled = false;

    if (error) {
      alert('Failed to update status');
      console.error(error);
      return;
    }

    // Update local data immediately
    const order = allOrders.find(o => String(o.id) === String(id));

if (order) {
  order.status = newStatus;
  filterOrders();
}
  });
});

// Delete
document.querySelectorAll('.delete-btn').forEach(btn => {
  btn.addEventListener('click', async (e) => {
    if (!confirm('Are you sure you want to delete this order?')) return;

    const id = e.target.dataset.id;

    // Disable button while deleting
    e.target.disabled = true;
    e.target.textContent = 'Deleting...';

    const { error } = await supabase
      .from('orders')
      .delete()
      .eq('id', id);

    if (error) {
      alert('Failed to delete order');
      console.error(error);

      e.target.disabled = false;
      e.target.textContent = 'Delete';
      return;
    }

    // Remove from local data immediately
    allOrders = allOrders.filter(
      order => String(order.id) !== String(id)
    );

    // Re-render current filtered/search result
    filterOrders();
  });
});
     
     
      }

      // Filters
      document.getElementById('statusFilter').addEventListener('change', filterOrders);
      document.getElementById('searchInput').addEventListener('input', filterOrders);

function filterOrders() {
  const status = document.getElementById('statusFilter').value;
  const search = document.getElementById('searchInput').value.toLowerCase();

  let filtered = allOrders.filter(order => {

    // Status filter
    if (status && order.status !== status) {
      return false;
    }

    // Search filter
    if (search) {
      const matchesSearch =
        (order.order_id || '').toLowerCase().includes(search) ||
        (order.full_name || '').toLowerCase().includes(search) ||
        (order.phone || '').toLowerCase().includes(search);

      if (!matchesSearch) {
        return false;
      }
    }

    return true;
  });

  renderOrders(filtered);
}

      // Logout
      document.getElementById('logoutBtn').addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = '/admin/login';
      });

      // Initial load
      loadOrders();
    </script>

  <style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: Arial, sans-serif;
    background: #f4f3ef;
    color: #151515;
  }

  .admin-layout {
    display: flex;
    min-height: 100vh;
  }

  /* =====================================================
     SIDEBAR
     ===================================================== */

  .sidebar {
    width: 220px;
    flex-shrink: 0;
    background: #151515;
    color: white;
    padding: 30px 20px;
    display: flex;
    flex-direction: column;
  }

  .logo {
    font-family: Georgia, serif;
    font-size: 22px;
    margin-bottom: 40px;
    letter-spacing: 1px;
  }

  nav a {
    display: block;
    color: #aaa;
    text-decoration: none;
    padding: 10px 0;
    font-size: 14px;
  }

  nav a.active,
  nav a:hover {
    color: white;
  }

  .logout-btn {
    margin-top: auto;
    background: transparent;
    border: 1px solid #444;
    color: #ccc;
    padding: 10px;
    cursor: pointer;
    font-size: 13px;
  }

  .logout-btn:hover {
    border-color: #888;
    color: white;
  }

  /* =====================================================
     MAIN CONTENT
     ===================================================== */

  .main-content {
    flex: 1;
    min-width: 0;
    padding: 30px 40px;
  }

  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .top-bar h1 {
    font-family: Georgia, serif;
    font-size: 28px;
    font-weight: 500;
  }

  /* =====================================================
     FILTERS
     ===================================================== */

  .filters {
    display: flex;
    gap: 12px;
  }

  .filters select,
  .filters input {
    padding: 10px 14px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 14px;
    background: white;
  }

  .filters input {
    min-width: 240px;
  }

  /* =====================================================
     TABLE
     ===================================================== */

  .table-wrap {
    width: 100%;
    background: white;
    border-radius: 8px;
    overflow-x: auto;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    -webkit-overflow-scrolling: touch;
  }

  table {
    width: 100%;
    min-width: 700px;
    border-collapse: collapse;
    font-size: 14px;
  }

  th {
    text-align: left;
    padding: 14px 16px;
    background: #fafafa;
    font-size: 11px;
    letter-spacing: 1px;
    color: #666;
    border-bottom: 1px solid #eee;
    white-space: nowrap;
  }

  td {
    padding: 14px 16px;
    border-bottom: 1px solid #f0f0f0;
  }

  tr:hover td {
    background: #fafafa;
  }

  /* =====================================================
     STATUS
     ===================================================== */

  .status-select {
    padding: 6px 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 13px;
    max-width: 100%;
  }

  /* =====================================================
     DELETE BUTTON
     ===================================================== */

  .delete-btn {
    background: none;
    border: 1px solid #e0a0a0;
    color: #c44d6a;
    padding: 5px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    white-space: nowrap;
  }

  .delete-btn:hover {
    background: #c44d6a;
    color: white;
  }

  /* =====================================================
     TABLET
     ===================================================== */

  @media (max-width: 900px) {

    .admin-layout {
      flex-direction: column;
    }

    /* SIDEBAR */

    .sidebar {
      width: 100%;
      padding: 16px 20px;
      flex-direction: row;
      align-items: center;
      gap: 20px;
    }

    .logo {
      margin-bottom: 0;
      flex-shrink: 0;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    nav a {
      padding: 6px 0;
    }

    .logout-btn {
      margin-top: 0;
      margin-left: auto;
      flex-shrink: 0;
    }

    /* MAIN */

    .main-content {
      width: 100%;
      padding: 24px 20px 40px;
    }

    /* FILTERS */

    .top-bar {
      align-items: flex-start;
    }

    .filters {
      width: 100%;
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 10px;
    }

    .filters select,
    .filters input {
      width: 100%;
      min-width: 0;
    }

    /* TABLE */

    .table-wrap {
      border-radius: 8px;
    }
  }

  /* =====================================================
     MOBILE
     ===================================================== */

  @media (max-width: 640px) {

    body {
      overflow-x: hidden;
    }

    /* SIDEBAR */

    .sidebar {
      padding: 14px 12px;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .logo {
      width: 100%;
      text-align: center;
      font-size: 20px;
      margin: 0;
      padding-bottom: 12px;
      border-bottom: 1px solid #2c2c2c;
    }

    nav {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 5px;
    }

    nav a {
      width: 100%;
      text-align: center;
      padding: 9px 4px;
      font-size: 12px;
      border: 1px solid #292929;
      border-radius: 4px;
    }

    nav a.active {
      background: #292929;
    }

    .logout-btn {
      width: 100%;
      margin: 0;
      padding: 10px;
      font-size: 12px;
    }

    /* MAIN */

    .main-content {
      width: 100%;
      padding: 20px 12px 40px;
    }

    /* HEADER */

    .top-bar {
      display: block;
      margin-bottom: 20px;
    }

    .top-bar h1 {
      font-size: 24px;
      line-height: 1.3;
      margin-bottom: 14px;
    }

    /* FILTERS */

    .filters {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .filters select,
    .filters input {
      width: 100%;
      min-width: 0;
      height: 42px;
      font-size: 13px;
    }

    /* TABLE */

    .table-wrap {
      width: 100%;
      overflow-x: auto;
      border-radius: 8px;
    }

    table {
      min-width: 700px;
      font-size: 13px;
    }

    th {
      padding: 11px 12px;
      font-size: 10px;
    }

    td {
      padding: 12px;
      white-space: nowrap;
    }

    .status-select {
      padding: 6px 8px;
      font-size: 12px;
    }

    .delete-btn {
      padding: 6px 9px;
      font-size: 11px;
    }
  }

  /* =====================================================
     SMALL PHONES
     ===================================================== */

  @media (max-width: 400px) {

    .sidebar {
      padding: 12px 10px;
    }

    .logo {
      font-size: 19px;
    }

    nav {
      grid-template-columns: repeat(3, 1fr);
      gap: 4px;
    }

    nav a {
      padding: 8px 2px;
      font-size: 11px;
    }

    .main-content {
      padding: 16px 10px 35px;
    }

    .top-bar h1 {
      font-size: 22px;
    }

    .filters select,
    .filters input {
      height: 40px;
      font-size: 12px;
      padding: 8px 10px;
    }

    table {
      min-width: 650px;
    }

    th {
      padding: 10px;
    }

    td {
      padding: 10px;
      font-size: 12px;
    }
  }
</style>
  </body>
</html>