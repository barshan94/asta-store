---
const title = "Forgot Password — ASTA Admin";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="login-page">
      <div class="login-box">
        <h1>Reset your password</h1>
        <p class="subtitle">We'll email you a link to set a new one</p>

        <form id="forgotForm">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" required placeholder="admin@example.com" />
          </div>
          <p id="errorMsg" class="error" style="display:none;"></p>
          <p id="successMsg" class="success" style="display:none;">
            If an account exists for that email, a password reset link has been sent to your inbox.
          </p>
          <button type="submit" id="sendBtn">Send reset link</button>
        </form>

        <div class="links">
          <a href="/admin/login">← Back to sign in</a>
        </div>
      </div>
    </div>

    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

      const supabase = createClient(
        'https://ryfufhtymvjeveppwjoj.supabase.co',
        'sb_publishable_nzsU-ZYMEiOz1hxfsC6Spw_GXfaaVfw',
        { auth: { storageKey: 'asta-admin-auth' } }
      );




      const form = document.getElementById('forgotForm');
      const errorMsg = document.getElementById('errorMsg');
      const successMsg = document.getElementById('successMsg');
      const btn = document.getElementById('sendBtn');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('email').value.trim();

        errorMsg.style.display = 'none';
        successMsg.style.display = 'none';
        btn.disabled = true;
        btn.textContent = 'Sending...';

        const { error } = await supabase.auth.resetPasswordForEmail(email, {
          redirectTo: `${window.location.origin}/admin/reset-password`
        });

        if (error) {
          errorMsg.textContent = error.message;
          errorMsg.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Send reset link';
          return;
        }

        form.style.display = 'none';
        successMsg.style.display = 'block';
        btn.textContent = 'Link Sent';
      });
    </script>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #f4f3ef;
    font-family: Arial, sans-serif;
  }

  .login-page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .login-box {
    background: white;
    padding: 40px;
    border-radius: 8px;
    width: 100%;
    max-width: 400px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  h1 {
    margin: 0 0 6px;
    font-family: Georgia, serif;
    font-size: 28px;
    line-height: 1.2;
  }

  .subtitle {
    color: #666;
    margin: 0 0 30px;
    font-size: 14px;
    line-height: 1.5;
  }

  .form-group {
    margin-bottom: 18px;
  }

  label {
    display: block;
    font-size: 12px;
    letter-spacing: 1px;
    color: #555;
    margin-bottom: 6px;
  }

  input {
    display: block;
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 15px;
    font-family: Arial, sans-serif;
    outline: none;
  }

  input:focus {
    border-color: #151515;
  }

  button {
    width: 100%;
    min-height: 48px;
    padding: 14px;
    background: #151515;
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    cursor: pointer;
    margin-top: 10px;
  }

  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .error {
    color: #c44d6a;
    font-size: 13px;
    line-height: 1.5;
    margin: 10px 0;
  }

  .success {
    color: #1a7a4c;
    font-size: 13px;
    line-height: 1.5;
    margin: 10px 0;
  }

  .links {
    margin-top: 24px;
    text-align: center;
    font-size: 13px;
    line-height: 1.5;
  }

  .links a {
    color: #008ca3;
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }


  /* =====================================================
     MOBILE
     ===================================================== */

  @media (max-width: 600px) {

    .login-page {
      padding: 16px;
    }

    .login-box {
      padding: 30px 24px;
      max-width: 100%;
    }

    h1 {
      font-size: 25px;
    }

    .subtitle {
      font-size: 13px;
      margin-bottom: 25px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    input {
      padding: 12px;
      font-size: 16px;
    }

    button {
      min-height: 48px;
      padding: 13px;
    }

    .error,
    .success {
      font-size: 12px;
    }

    .links {
      margin-top: 20px;
      font-size: 12px;
    }
  }


  /* =====================================================
     SMALL PHONES
     ===================================================== */

  @media (max-width: 380px) {

    .login-page {
      padding: 12px;
    }

    .login-box {
      padding: 26px 18px;
      border-radius: 7px;
    }

    h1 {
      font-size: 23px;
    }

    .subtitle {
      font-size: 12px;
      margin-bottom: 22px;
    }

    .form-group {
      margin-bottom: 14px;
    }

    label {
      font-size: 11px;
    }

    input {
      padding: 11px;
      font-size: 16px;
    }

    button {
      font-size: 13px;
      padding: 12px;
    }

    .error,
    .success {
      font-size: 12px;
    }

    .links {
      margin-top: 18px;
      font-size: 12px;
    }
  }
</style>
  </body>
</html>