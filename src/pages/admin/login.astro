---
const title = "Admin Login — ASTA";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="login-page">
      <div class="login-box">
        <h1>ASTA Admin</h1>
        <p class="subtitle">Sign in to manage orders</p>

        <form id="loginForm">
          <div class="form-group">
            <label>Email</label>
            <input type="email" id="email" required placeholder="admin@example.com" />
          </div>

          <div class="form-group">
            <label>Password</label>
            <input type="password" id="password" required placeholder="••••••••" />
          </div>

          <p id="errorMsg" class="error" style="display:none;"></p>

          <button type="submit" id="loginBtn">Sign In</button>
        </form>

        <div class="links">
          <a href="/admin/forgot-password">Forgot password?</a>
          <a href="/admin/register">Create admin account</a>
        </div>
      </div>
    </div>

    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

const supabase = createClient(
  'https://ryfufhtymvjeveppwjoj.supabase.co',
  'sb_publishable_nzsU-ZYMEiOz1hxfsC6Spw_GXfaaVfw',
  { auth: { storageKey: 'asta-admin-auth' } }
);
      // If already logged in → go to dashboard
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        window.location.href = '/admin';
      }

      document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;
        const errorMsg = document.getElementById('errorMsg');
        const btn = document.getElementById('loginBtn');

        btn.disabled = true;
        btn.textContent = 'Signing in...';
        errorMsg.style.display = 'none';

        const { error } = await supabase.auth.signInWithPassword({
          email,
          password
        });

        if (error) {
          errorMsg.textContent = error.message;
          errorMsg.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Sign In';
          return;
        }

        window.location.href = '/admin';
      });
    </script>

 <style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: #f4f3ef;
    font-family: Arial, sans-serif;
  }

  .login-page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .login-box {
    background: white;
    padding: 40px;
    border-radius: 8px;
    width: 100%;
    max-width: 400px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  h1 {
    margin: 0 0 6px;
    font-family: Georgia, serif;
    font-size: 28px;
    line-height: 1.2;
  }

  .subtitle {
    color: #666;
    margin: 0 0 30px;
    font-size: 14px;
    line-height: 1.5;
  }

  .form-group {
    margin-bottom: 18px;
  }

  label {
    display: block;
    font-size: 12px;
    letter-spacing: 1px;
    color: #555;
    margin-bottom: 6px;
  }

  input {
    display: block;
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 15px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease;
  }

  input:focus {
    border-color: #151515;
  }

  button {
    display: block;
    width: 100%;
    padding: 14px;
    background: #151515;
    color: white;
    border: none;
    border-radius: 4px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    cursor: pointer;
    margin-top: 10px;
    min-height: 48px;
  }

  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .error {
    color: #c44d6a;
    font-size: 13px;
    line-height: 1.5;
    margin: 10px 0;
  }

  .links {
    margin-top: 24px;
    display: flex;
    justify-content: space-between;
    gap: 15px;
    font-size: 13px;
  }

  .links a {
    color: #008ca3;
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }


  /* =====================================================
     MOBILE
     ===================================================== */

  @media (max-width: 600px) {

    .login-page {
      padding: 16px;
      align-items: center;
    }

    .login-box {
      padding: 30px 24px;
      max-width: 100%;
      border-radius: 8px;
    }

    h1 {
      font-size: 25px;
    }

    .subtitle {
      margin-bottom: 25px;
      font-size: 13px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    input {
      padding: 12px;
      font-size: 16px;
    }

    button {
      padding: 13px;
      min-height: 48px;
    }

    .links {
      margin-top: 20px;
      font-size: 12px;
    }
  }


  /* =====================================================
     SMALL PHONES
     ===================================================== */

  @media (max-width: 380px) {

    .login-page {
      padding: 12px;
    }

    .login-box {
      padding: 26px 18px;
    }

    h1 {
      font-size: 23px;
    }

    .subtitle {
      font-size: 12px;
      margin-bottom: 22px;
    }

    label {
      font-size: 11px;
    }

    input {
      padding: 11px;
      font-size: 16px;
    }

    button {
      font-size: 13px;
      padding: 12px;
    }

    .links {
      flex-direction: column;
      align-items: center;
      gap: 10px;
      text-align: center;
    }
  }
</style>
  </body>
</html>