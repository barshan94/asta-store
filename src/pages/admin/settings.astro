          </div>

        </form>
      </main>
    </div>

    <!-- JAVASCRIPT -->
<script type="module">
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

const supabase = createClient(
  'https://ryfufhtymvjeveppwjoj.supabase.co',
  'sb_publishable_nzsU-ZYMEiOz1hxfsC6Spw_GXfaaVfw',
  { auth: { storageKey: 'asta-admin-auth' } }
);

  const get = (id) => document.getElementById(id);

  // =========================================================
  // AUTH + LOAD SETTINGS
  // =========================================================

  async function checkAuthAndLoad() {
    document.body.style.display = 'none';

    const {
      data: { session },
      error
    } = await supabase.auth.getSession();

    if (error) {
      console.error('Auth error:', error);
      window.location.replace('/admin/login');
      return;
    }

    if (!session) {
      window.location.replace('/admin/login');
      return;
    }

    document.body.style.display = 'block';

    // Show logged-in email
    if (get('currentEmail')) {
      get('currentEmail').value = session.user.email || '';
    }

    // Load settings
    const { data, error: settingsError } = await supabase
      .from('site_settings')
      .select('*');

    if (settingsError) {
      console.error('Settings error:', settingsError);

      showMessage(
        'Could not load site settings: ' + settingsError.message,
        'error'
      );

      return;
    }

    if (data) {
      data.forEach((row) => {
        const input = get(row.key);

        if (!input) return;

        // Checkbox
        if (input.type === 'checkbox') {
          input.checked =
            row.value === true ||
            row.value === 'true' ||
            row.value === '1';
        }

        // Everything else
        else {
          input.value = row.value ?? '';
        }
      });

      // Load image previews from saved URLs
// Load saved image URLs into previews
data.forEach((row) => {

  if (row.key === 'logoUrl' && row.value) {
    get('logoPreview').src = row.value;
  }

  if (row.key === 'heroUrl' && row.value) {
    get('heroPreview').src = row.value;
  }

  if (row.key === 'testimonialImageUrl' && row.value) {
    get('testimonialPreview').src = row.value;
  }

});
    }
  }


  // =========================================================
  // IMAGE PREVIEW
  // =========================================================




  // =========================================================
  // AUTH STATE LISTENER
  // =========================================================

  supabase.auth.onAuthStateChange((event) => {
    console.log('Auth event:', event);

    if (event === 'SIGNED_OUT') {
      window.location.replace('/admin/login');
    }
  });


  // =========================================================
  // LOGOUT
  // =========================================================

  get('logoutBtn')?.addEventListener('click', async () => {
    const { error } = await supabase.auth.signOut();

    if (error) {
      console.error('Logout error:', error);
      return;
    }

    window.location.replace('/admin/login');
  });


  // =========================================================
  // CHANGE PASSWORD
  // =========================================================

  get('changePasswordForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const newPassword = get('newPassword').value;
    const confirmPassword = get('confirmPassword').value;

    const pwError = get('pwError');
    const pwSuccess = get('pwSuccess');
    const pwBtn = get('pwBtn');

    pwError.style.display = 'none';
    pwSuccess.style.display = 'none';

    if (newPassword !== confirmPassword) {
      pwError.textContent = 'Passwords do not match.';
      pwError.style.display = 'block';
      return;
    }

    if (newPassword.length < 6) {
      pwError.textContent =
        'Password must be at least 6 characters.';
      pwError.style.display = 'block';
      return;
    }

    pwBtn.disabled = true;
    pwBtn.textContent = 'Updating...';

    try {
      const { error } = await supabase.auth.updateUser({
        password: newPassword
      });

      if (error) {
        console.error('Password update error:', error);

        pwError.textContent = error.message;
        pwError.style.display = 'block';
        return;
      }

      pwSuccess.textContent =
        'Password updated successfully.';
      pwSuccess.style.display = 'block';

      get('newPassword').value = '';
      get('confirmPassword').value = '';

    } catch (err) {
      console.error('Unexpected password update error:', err);

      pwError.textContent =
        'Something went wrong. Please try again.';
      pwError.style.display = 'block';

    } finally {
      pwBtn.disabled = false;
      pwBtn.textContent = 'Update Password';
    }
  });


  // =========================================================
  // IMAGE PREVIEW WHEN USER SELECTS A FILE
  // =========================================================

  function setupFilePreview(fileInputId, previewId) {
    const fileInput = get(fileInputId);
    const preview = get(previewId);

    if (!fileInput || !preview) return;

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];

      if (!file) return;

      if (!file.type.startsWith('image/')) {
        alert('Please select an image file.');
        fileInput.value = '';
        return;
      }

      const objectUrl = URL.createObjectURL(file);

      preview.src = objectUrl;
      preview.onload = () => {
        URL.revokeObjectURL(objectUrl);
      };
    });
  }

  setupFilePreview('logoFile', 'logoPreview');
  setupFilePreview('heroFile', 'heroPreview');
  setupFilePreview('testimonialFile', 'testimonialPreview');


  // =========================================================
  // UPLOAD IMAGE TO SUPABASE STORAGE
  // =========================================================

  async function uploadImage(file, folder) {
    if (!file) {
      return null;
    }

    // Maximum 5 MB
    const maxSize = 5 * 1024 * 1024;

    if (file.size > maxSize) {
      throw new Error(
        `${folder} image is too large. Maximum size is 5 MB.`
      );
    }

    if (!file.type.startsWith('image/')) {
      throw new Error(
        `${folder} must be an image file.`
      );
    }

    const fileExtension =
      file.name.split('.').pop()?.toLowerCase() || 'jpg';

    const fileName =
      `${folder}-${Date.now()}-${Math.random()
        .toString(36)
        .substring(2, 8)}.${fileExtension}`;

    const filePath = `${folder}/${fileName}`;

    console.log('Uploading:', filePath);

    const { error: uploadError } = await supabase.storage
      .from('site')
      .upload(filePath, file, {
        cacheControl: '3600',
        upsert: false
      });

    if (uploadError) {
      console.error('Upload error:', uploadError);
      throw new Error(
        `Could not upload ${folder}: ${uploadError.message}`
      );
    }

    const {
      data: { publicUrl }
    } = supabase.storage
      .from('site')
      .getPublicUrl(filePath);

    console.log('Uploaded URL:', publicUrl);

    return publicUrl;
  }


  // =========================================================
  // SAVE ONE SETTING
  // =========================================================

  async function saveSetting(key, value) {
    const { error } = await supabase
      .from('site_settings')
      .upsert(
        {
          key: key,
          value: String(value ?? '')
        },
        {
          onConflict: 'key'
        }
      );

    if (error) {
      throw new Error(
        `Failed to save "${key}": ${error.message}`
      );
    }
  }


  // =========================================================
  // GET ALL FORM SETTINGS
  // =========================================================

  function collectSettings() {
    const form = get('settingsForm');

    if (!form) return {};

    const settings = {};

    const elements = form.querySelectorAll(
      'input[id], textarea[id], select[id]'
    );

    elements.forEach((input) => {

      // Skip file inputs
      if (input.type === 'file') return;

      // Checkbox
      if (input.type === 'checkbox') {
        settings[input.id] = input.checked ? 'true' : 'false';
      }

      // Text / textarea / URL etc.
      else {
        settings[input.id] = input.value;
      }
    });

    return settings;
  }


  // =========================================================
  // MESSAGE
  // =========================================================

  function showMessage(message, type) {
    const formMessage = get('formMessage');

    if (!formMessage) return;

    formMessage.textContent = message;

    formMessage.className = 'message ' + type;

    formMessage.style.display = 'block';

    // Automatically hide after 5 seconds
    setTimeout(() => {
      formMessage.style.display = 'none';
    }, 5000);
  }


  // =========================================================
  // SAVE ALL SETTINGS
  // =========================================================

  get('settingsForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const saveBtn = get('saveBtn');

    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    get('formMessage').style.display = 'none';

    try {

      // -----------------------------------------------------
      // 1. Collect normal settings
      // -----------------------------------------------------

      const settings = collectSettings();

      console.log('Settings to save:', settings);


      // -----------------------------------------------------
      // 2. Upload LOGO if selected
      // -----------------------------------------------------

      const logoFile = get('logoFile')?.files?.[0];

      if (logoFile) {
        saveBtn.textContent = 'Uploading logo...';

        const logoUrl = await uploadImage(
          logoFile,
          'logo'
        );

        settings.logoUrl = logoUrl;
      }


      // -----------------------------------------------------
      // 3. Upload HERO if selected
      // -----------------------------------------------------

      const heroFile = get('heroFile')?.files?.[0];

      if (heroFile) {
        saveBtn.textContent = 'Uploading hero...';

        const heroUrl = await uploadImage(
          heroFile,
          'hero'
        );

        settings.heroUrl = heroUrl;
      }


      // -----------------------------------------------------
      // 4. Upload TESTIMONIAL if selected
      // -----------------------------------------------------

      const testimonialFile =
        get('testimonialFile')?.files?.[0];

      if (testimonialFile) {
        saveBtn.textContent =
          'Uploading testimonial...';

        const testimonialUrl = await uploadImage(
          testimonialFile,
          'testimonial'
        );

        settings.testimonialImageUrl =
          testimonialUrl;
      }


      // -----------------------------------------------------
      // 5. Save EVERYTHING to site_settings
      // -----------------------------------------------------

      saveBtn.textContent = 'Saving settings...';

      const entries = Object.entries(settings);

      for (const [key, value] of entries) {

        await saveSetting(key, value);

      }


      // -----------------------------------------------------
      // 6. Success
      // -----------------------------------------------------

      showMessage(
        'All settings saved successfully.',
        'success'
      );

      saveBtn.textContent = 'Saved ✓';

      // Clear selected files
      if (get('logoFile')) {
        get('logoFile').value = '';
      }

      if (get('heroFile')) {
        get('heroFile').value = '';
      }

      if (get('testimonialFile')) {
        get('testimonialFile').value = '';
      }

      // Return button to normal after 2 seconds
      setTimeout(() => {
        saveBtn.textContent = 'Save All Settings';
        saveBtn.disabled = false;
      }, 2000);


    } catch (error) {

      console.error('SAVE ERROR:', error);

      showMessage(
        error.message || 'Failed to save settings.',
        'error'
      );

      saveBtn.disabled = false;
      saveBtn.textContent = 'Save All Settings';
    }
  });


  // =========================================================
  // START
  // =========================================================

  checkAuthAndLoad();

</script>

