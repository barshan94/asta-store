---
const title = "Site Settings — ASTA Admin";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <div class="admin-layout">

      <!-- SIDEBAR -->
      <aside class="sidebar">
        <div class="logo">
          ASTA Admin
        </div>
        <nav>
          <a href="/admin">Orders</a>
          <a href="/admin/products">Products</a>
          <a href="/admin/settings" class="active">Settings</a>
        </nav>
        <button id="logoutBtn" class="logout-btn">
          Logout
        </button>
      </aside>

      <!-- MAIN -->
      <main class="main-content">
        <header class="top-bar">
          <div>
            <h1>Site Settings</h1>
            <p>
              Control the content and account settings of your ASTA website from here.
            </p>
          </div>
        </header>

        <!-- ACCOUNT & PASSWORD SECTION -->
        <section class="setting-card">
          <div class="section-heading">
            <h2>Account Details</h2>
            <p>Your current login session details.</p>
          </div>
          <div class="form-group">
            <label for="currentEmail">Signed in as</label>
            <input type="email" id="currentEmail" disabled />
          </div>
        </section>

        <section class="setting-card">
          <div class="section-heading">
            <h2>Change Password</h2>
            <p>Choose a new password for your admin account.</p>
          </div>
          <form id="changePasswordForm">
            <div class="form-group">
              <label for="newPassword">New Password</label>
              <input type="password" id="newPassword" required minlength="6" placeholder="••••••••" />
            </div>
            <div class="form-group">
              <label for="confirmPassword">Confirm New Password</label>
              <input type="password" id="confirmPassword" required minlength="6" placeholder="••••••••" />
            </div>
            <p id="pwError" class="message error" style="display:none;"></p>
            <p id="pwSuccess" class="message success" style="display:none;">Password updated successfully.</p>
            <div style="margin-top: 16px;">
              <button type="submit" id="pwBtn" class="btn-primary">Update Password</button>
            </div>
          </form>
        </section>

        <!-- SITE CONTENT FORM -->
        <form id="settingsForm" class="settings-form">

          <!-- GENERAL / BRAND -->
          <section class="setting-card">
            <div class="section-heading">
              <h2>General & Brand</h2>
              <p>Basic information used throughout the website.</p>
            </div>

            <div class="form-group">
              <label for="siteName">Site Name</label>
              <input type="text" id="siteName" placeholder="ASTA" />
            </div>

            <div class="form-group">
              <label for="pageTitle">Browser Page Title</label>
              <input type="text" id="pageTitle" placeholder="ASTA — Handmade Leather" />
            </div>

            <div class="form-group">
              <label for="facebookUrl">Facebook URL</label>
              <input type="url" id="facebookUrl" placeholder="https://facebook.com/..." />
            </div>

            <div class="form-group">
              <label for="whatsappNumber">WhatsApp Number</label>
              <input type="text" id="whatsappNumber" placeholder="8801XXXXXXXXX" />
              <p class="hint">Use international format without + or spaces. Example: 8801712345678</p>
            </div>

            <div class="form-group">
              <label for="whatsappUrl">WhatsApp URL</label>
              <input type="url" id="whatsappUrl" placeholder="https://wa.me/8801XXXXXXXXX" />
            </div>
          </section>

          <!-- LOGO -->
          <section class="setting-card">
            <div class="section-heading">
              <h2>Logo</h2>
              <p>Upload the logo displayed on the website.</p>
            </div>

            <div class="image-row">
              <img id="logoPreview" src="" alt="Logo preview" class="preview-img" />
              <div class="upload-area">
                <input type="file" id="logoFile" accept="image/png,image/jpeg,image/webp" />
                <p class="hint">Recommended: square PNG, JPG or WebP.</p>
              </div>
            </div>
          </section>

          <!-- INFO BAR -->
          <section class="setting-card">
            <div class="section-heading">
              <h2>Info Bar</h2>
              <p>The small information messages shown across the homepage.</p>
            </div>

            <div class="form-group">
              <label for="editionLabel">Edition Label</label>
              <input type="text" id="editionLabel" placeholder="EDITION NO. 04" />
            </div>

            <div class="form-group">
              <label for="infoBar2">Info Bar 2</label>
              <input type="text" id="infoBar2" placeholder="HANDMADE LEATHER DHAKA" />
            </div>

            <div class="form-group">
              <label for="infoBar3">Info Bar 3</label>
              <input type="text" id="infoBar3" placeholder="CASH ON DELIVERY" />
            </div>

            <div class="form-group">
              <label for="infoBar4">Info Bar 4</label>
              <input type="text" id="infoBar4" placeholder="EXCHANGE WITHIN THREE DAYS" />
            </div>
          </section>

          <!-- ORDER PAGE SETTINGS -->
          <section class="setting-card">
            <div class="section-heading">
              <h2>Order Page (Mail order coupon)</h2>
              <p>Configure text content and payment descriptions for the order flow.</p>
            </div>

            <div class="form-group">
              <label for="orderPageTitle">Page Title</label>
              <input type="text" id="orderPageTitle" placeholder="Mail order coupon" />
            </div>

            <div class="form-group">
              <label for="orderPageNote">Page Note</label>
              <input type="text" id="orderPageNote" placeholder="FILL IN INK · WE CALL TO CONFIRM" />
            </div>

            <div class="form-group">
              <label for="orderBackLink">Back Link Text</label>
              <input type="text" id="orderBackLink" placeholder="← BACK TO THE EDITION" />
            </div>

            <div class="form-group">
              <label for="orderFooterNote">Footer Note under button</label>
              <input type="text" id="orderFooterNote" placeholder="Nothing is charged online. We ring you within a few hours." />
            </div>

            <hr style="margin: 20px 0; border: none; border-top: 1px solid #eee;" />

            <h3 style="margin-bottom: 12px; font-size: 14px; font-weight: 600; color: #555;">Payment Options</h3>

            <div class="form-group">
              <label for="paymentCodTitle">Cash on delivery - Title</label>
              <input type="text" id="paymentCodTitle" />
            </div>
            <div class="form-group">
              <label for="paymentCodDesc">Cash on delivery - Description</label>
              <input type="text" id="paymentCodDesc" />
            </div>

            <div class="form-group">
              <label for="paymentBkashTitle">BKash Title</label>
              <input type="text" id="paymentBkashTitle" />
            </div>
            <div class="form-group">
              <label for="paymentBkashDesc">BKash Description</label>
              <input type="text" id="paymentBkashDesc" />
            </div>

            <div class="form-group">
              <label for="paymentNagadTitle">Nagad Title</label>
              <input type="text" id="paymentNagadTitle" />
            </div>
            <div class="form-group">
              <label for="paymentNagadDesc">Nagad Description</label>
              <input type="text" id="paymentNagadDesc" />
            </div>

            <div class="form-group">
              <label for="paymentBankTitle">Bank transfer Title</label>
              <input type="text" id="paymentBankTitle" />
            </div>
            <div class="form-group">
              <label for="paymentBankDesc">Bank transfer Description</label>
              <input type="text" id="paymentBankDesc" />
            </div>
          </section>

          <!-- HERO -->
          <section class="setting-card">
            <div class="section-heading">
              <h2>Hero Section</h2>
              <p>The main banner visitors see when they enter your website.</p>
            </div>

            <div class="image-row hero-upload">
              <img id="heroPreview" src="" alt="Hero preview" class="preview-img hero-preview" />
              <div class="upload-area">
                <input type="file" id="heroFile" accept="image/png,image/jpeg,image/webp" />
                <p class="hint">Main hero/banner image.</p>
              </div>
            </div>

            <div class="form-group">
              <label for="heroTitle">Hero Title</label>
              <textarea id="heroTitle" rows="4" placeholder="Crafted to stand the test of time"></textarea>
              <p class="hint">You can use line breaks to control the appearance of the heading.</p>
            </div>

            <div class="form-group">
              <label for="heroDescription">Hero Description</label>
              <textarea id="heroDescription" rows="5" placeholder="Describe your collection..."></textarea>
            </div>

            <div class="two-column">
              <div class="form-group">
                <label for="heroButton1Text">Button 1 Text</label>
                <input type="text" id="heroButton1Text" placeholder="SEE THE EDITION" />
              </div>

              <div class="form-group">
                <label for="heroButton1Link">Button 1 Link</label>
                <input type="text" id="heroButton1Link" placeholder="#edition" />
              </div>
            </div>

            <div class="two-column">
              <div class="form-group">
                <label for="heroButton2Text">Button 2 Text</label>
                <input type="text" id="heroButton2Text" placeholder="ASK ON WHATSAPP" />
              </div>

              <div class="form-group">
                <label for="heroButton2Link">Button 2 Link</label>
                <input type="text" id="heroButton2Link" placeholder="https://wa.me/..." />
              </div>
            </div>
          </section>

          <!-- STATISTICS -->
          <section class="setting-card">
            <div class="section-heading">
              <h2>Statistics</h2>
              <p>The four information blocks displayed below the hero section.</p>
            </div>

            <div class="stats-grid">
              <div class="stat-box">
                <span>Stat 01</span>
                <div class="form-group">
                  <label for="stat1Value">Value</label>
                  <input type="text" id="stat1Value" placeholder="04" />
                </div>
                <div class="form-group">
                  <label for="stat1Label">Label</label>
                  <input type="text" id="stat1Label" placeholder="Bags in this edition" />
                </div>
              </div>

              <div class="stat-box">
                <span>Stat 02</span>
                <div class="form-group">
                  <label for="stat2Value">Value</label>
                  <input type="text" id="stat2Value" placeholder="0" />
                </div>
                <div class="form-group">
                  <label for="stat2Label">Label</label>
                  <input type="text" id="stat2Label" placeholder="Card gateways used" />
                </div>
              </div>

              <div class="stat-box">
                <span>Stat 03</span>
                <div class="form-group">
                  <label for="stat3Value">Value</label>
                  <input type="text" id="stat3Value" placeholder="৳80" />
                </div>
                <div class="form-group">
                  <label for="stat3Label">Label</label>
                  <input type="text" id="stat3Label" placeholder="Delivery inside Dhaka" />
                </div>
              </div>

              <div class="stat-box">
                <span>Stat 04</span>
                <div class="form-group">
                  <label for="stat4Value">Value</label>
                  <input type="text" id="stat4Value" placeholder="3" />
                </div>
                <div class="form-group">
                  <label for="stat4Label">Label</label>
                  <input type="text" id="stat4Label" placeholder="Exchange window, days" />
                </div>
              </div>
            </div>
          </section>

          <!-- EDITION -->
          <section class="setting-card">
            <div class="section-heading">
              <h2>Edition Section</h2>
              <p>Heading displayed above the products.</p>
            </div>

            <div class="form-group">
              <label for="editionHeading">Edition Heading</label>
              <input type="text" id="editionHeading" placeholder="The edition" />
            </div>

            <div class="form-group">
              <label for="editionSubheading">Edition Subheading</label>
              <input type="text" id="editionSubheading" placeholder="FOUR BAGS IN STOCK TODAY" />
            </div>

            <p class="info-note">
              Products themselves are managed separately from the <strong>Products</strong> page.
            </p>
          </section>

          <!-- TESTIMONIAL -->
          <section class="setting-card">
            <div class="section-heading">
              <h2>Customer Testimonial</h2>
              <p>Customer review displayed on the homepage.</p>
            </div>

            <div class="image-row">
              <img id="testimonialPreview" src="" alt="Testimonial preview" class="preview-img testimonial-preview" />
              <div class="upload-area">
                <input type="file" id="testimonialFile" accept="image/png,image/jpeg,image/webp" />
                <p class="hint">Customer/testimonial image.</p>
              </div>
            </div>

            <div class="form-group">
              <label for="testimonialQuote">Customer Quote</label>
              <textarea id="testimonialQuote" rows="5" placeholder="Write the customer's review..."></textarea>
            </div>

            <div class="two-column">
              <div class="form-group">
                <label for="testimonialAuthor">Customer Name</label>
                <input type="text" id="testimonialAuthor" placeholder="Nusrat J." />
              </div>

              <div class="form-group">
                <label for="testimonialLocation">Location</label>
                <input type="text" id="testimonialLocation" placeholder="Dhaka" />
              </div>
            </div>
          </section>

          <!-- ORDERING -->
          <section class="setting-card">
            <div class="section-heading">
              <h2>Ordering Section</h2>
              <p>Explain to customers how ordering works.</p>
            </div>

            <div class="form-group">
              <label for="orderingTitle">Section Title</label>
              <input type="text" id="orderingTitle" placeholder="How to order" />
            </div>

            <div class="form-group">
              <label for="orderingDescription">Description</label>
              <textarea id="orderingDescription" rows="4" placeholder="Explain your ordering process"></textarea>
            </div>

            <!-- STEP 01 -->
            <div class="step-card">
              <h3>Step 01</h3>
              <div class="form-group">
                <label for="orderStep1Description">Description</label>
                <textarea id="orderStep1Description" rows="3" placeholder="Add the bag and the colour you want to the slip..."></textarea>
              </div>
            </div>

            <!-- STEP 02 -->
            <div class="step-card">
              <h3>Step 02</h3>
              <div class="form-group">
                <label for="orderStep2Description">Description</label>
                <textarea id="orderStep2Description" rows="3" placeholder="Fill the coupon — name, phone, address"></textarea>
              </div>
            </div>

            <!-- STEP 03 -->
            <div class="step-card">
              <h3>Step 03</h3>
              <div class="form-group">
                <label for="orderStep3Description">Description</label>
                <textarea id="orderStep3Description" rows="3" placeholder="We confirm on WhatsApp..."></textarea>
              </div>
            </div>

            <!-- DELIVERY FEES -->
            <div class="two-column">
              <div class="form-group">
                <label for="deliveryInsideDhaka">Delivery Fee — Inside Dhaka</label>
                <input type="text" id="deliveryInsideDhaka" placeholder="80" />
              </div>

              <div class="form-group">
                <label for="deliveryOutsideDhaka">Delivery Fee — Outside Dhaka</label>
                <input type="text" id="deliveryOutsideDhaka" placeholder="130" />
              </div>
            </div>
          </section>

          <!-- FOOTER -->
          <section class="setting-card">
            <div class="section-heading">
              <h2>Footer & Contact</h2>
              <p>Information and contact options displayed at the bottom of the site.</p>
            </div>

            <div class="form-group">
              <label for="footerText">Footer Text</label>
              <textarea id="footerText" rows="4" placeholder="ASTA — handmade leather"></textarea>
            </div>

            <div class="form-group">
              <label for="footerFacebook">Facebook URL</label>
              <input type="url" id="footerFacebook" placeholder="https://facebook.com/..." />
            </div>

            <div class="form-group">
              <label for="footerWhatsapp">WhatsApp URL</label>
              <input type="url" id="footerWhatsapp" placeholder="https://wa.me/..." />
            </div>

            <!-- FLOATING WHATSAPP -->
