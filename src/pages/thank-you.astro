}


/* ========================================== */
/* MOBILE */
/* 600px and below */
/* ========================================== */

@media (max-width: 600px) {

  /* ================================= */
  /* GLOBAL MOBILE SAFETY */
  /* ================================= */

  html,
  body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }


  /* ================================= */
  /* HEADER */
  /* ================================= */

  .header {
    padding: 18px 16px 0;
  }

  .double-lines {
    margin-bottom: 16px;
  }

  .header-content {
    gap: 10px;
    padding-bottom: 16px;
    min-width: 0;
  }

  .logo-wrapper {
    flex: 1 1 auto;
    min-width: 0;
    gap: 9px;
  }

  .logo-icon {
    width: 46px;
    height: 46px;
  }

  .logo {
    min-width: 0;
    font-size: clamp(30px, 9vw, 40px);
    letter-spacing: 2px;
    overflow: hidden;
    text-overflow: clip;
  }

  .right-side {
    flex-shrink: 0;
    gap: 7px;
  }

  .right-side a {
    display: none;
  }

  .cart-header-btn {
    padding: 8px 9px;
    gap: 5px;
    min-height: 36px;
    font-size: 8px;
    letter-spacing: 0.7px;
  }

  .cart-icon {
    width: 13px;
    height: 13px;
  }


  /* ================================= */
  /* INFO BAR */
  /* ================================= */

  .info-bar {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    padding: 0;
    font-size: 8px;
    letter-spacing: 0.8px;
    text-align: center;
  }

  .info-bar span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 38px;
    padding: 7px 5px;
    white-space: normal;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .info-bar span:nth-child(1),
  .info-bar span:nth-child(2) {
    border-bottom: 1px solid #d4d2cc;
  }

  .info-bar span:nth-child(1),
  .info-bar span:nth-child(3) {
    border-right: 1px solid #d4d2cc;
  }


  /* ================================= */
  /* MAIN PAGE */
  /* ================================= */

  .thankyou-page {
    width: 100%;
    max-width: none;
    padding: 32px 16px 60px;
  }


  /* ================================= */
  /* ORDER RECEIVED */
  /* ================================= */

  .order-received-label {
    font-size: 8px;
    letter-spacing: 1.3px;
    line-height: 1.5;
    margin-bottom: 11px;
  }


  /* ================================= */
  /* ORDER ID */
  /* ================================= */

  .order-id {
    width: 100%;
    max-width: 100%;
    font-size: clamp(34px, 11vw, 50px);
    line-height: 1;
    letter-spacing: -1px;
    margin-bottom: 18px;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .order-id-text {
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }


  /* ================================= */
  /* THANK YOU MESSAGE */
  /* ================================= */

  .thank-you-name {
    font-size: clamp(22px, 6vw, 26px);
    line-height: 1.25;
    margin-bottom: 12px;
  }

  .thank-you-text {
    font-size: 15px;
    line-height: 1.65;
    margin-bottom: 24px;
  }


  /* ================================= */
  /* WHATSAPP BUTTON */
  /* ================================= */

  .confirm-whatsapp-btn {
    width: 100%;
    max-width: 100%;
    min-height: 46px;
    margin-bottom: 32px;
    padding: 14px 15px;
    font-size: 9px;
    line-height: 1.3;
    letter-spacing: 1px;
    text-align: center;
  }

  .confirm-whatsapp-btn svg {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
  }


  /* ================================= */
  /* ORDER TABLE */
  /* ================================= */

  .order-table-wrap {
    width: 100%;
    margin-bottom: 28px;
    overflow-x: hidden;
  }

  .order-table {
    width: 100%;
    max-width: 100%;
    font-size: 12px;
    table-layout: fixed;
  }

  .order-table th {
    font-size: 7px;
    letter-spacing: 0.8px;
    padding: 8px 4px 8px 0;
    line-height: 1.3;
  }

  .order-table td {
    padding: 10px 4px 10px 0;
    line-height: 1.4;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  /* Product */
  .order-table th:nth-child(1),
  .order-table td:nth-child(1) {
    width: 43%;
  }

  /* Quantity / details */
  .order-table th:nth-child(2),
  .order-table td:nth-child(2) {
    width: 32%;
  }

  /* Price */
  .order-table th:nth-child(3),
  .order-table td:nth-child(3) {
    width: 25%;
    padding-right: 0;
    text-align: right;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  /* Total row */
  .order-table .total-row td {
    padding: 12px 6px;
    font-size: 11px;
    line-height: 1.3;
  }

  .order-table .total-row td:first-child {
    padding-left: 6px;
  }

  .order-table .total-row td:last-child {
    padding-right: 6px;
  }


  /* ================================= */
  /* DELIVERY */
  /* ================================= */

  .shipped-to {
    width: 100%;
    margin-bottom: 24px;
  }

  .shipped-label {
    font-size: 8px;
    letter-spacing: 1.3px;
    margin-bottom: 7px;
  }

  .shipped-to p {
    font-size: 14px;
    line-height: 1.55;
    overflow-wrap: anywhere;
    word-break: break-word;
  }


  /* ================================= */
  /* EMAIL / FACEBOOK NOTE */
  /* ================================= */

  .email-note {
    font-size: 11px;
    line-height: 1.65;
    margin: 22px 0 20px;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .email-note a {
    overflow-wrap: anywhere;
    word-break: break-word;
  }


  /* ================================= */
  /* BACK BUTTON */
  /* ================================= */

  .back-to-edition {
    display: inline-block;
    max-width: 100%;
    padding: 7px 0;
    font-size: 9px;
    letter-spacing: 1.2px;
  }


  /* ================================= */
  /* FOOTER */
  /* ================================= */

  .footer {
    padding: 28px 16px 85px;
  }

  .footer-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding-top: 20px;
    font-size: 9px;
    letter-spacing: 1px;
  }

  .footer-left {
    width: 100%;
    font-size: 8px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .footer-right {
    width: 100%;
    justify-content: flex-start;
    gap: 14px;
    flex-wrap: wrap;
  }

  .footer-right a {
    font-size: 8px;
    letter-spacing: 1px;
  }


  /* ================================= */
  /* FLOATING BUTTONS */
  /* ================================= */

  .floating-buttons {
    right: 10px;
    bottom: calc(10px + env(safe-area-inset-bottom));
    gap: 8px;
    max-width: calc(100vw - 20px);
  }

  .fb-btn {
    width: 40px;
    height: 40px;
  }

  .fb-btn svg {
    width: 16px;
    height: 16px;
  }

  .wa-btn {
    min-height: 40px;
    height: 40px;
    padding: 0 13px;
    border-radius: 20px;
    font-size: 8px;
    letter-spacing: 1px;
  }

  .wa-btn svg {
    width: 16px;
    height: 16px;
  }
}


/* ========================================== */
